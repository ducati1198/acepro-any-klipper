+
+<script lang="ts">
+import { Component, Mixins } from 'vue-property-decorator'
+import AceProMixin from '@/components/widgets/acepro/acepro'
+import AceProRackUnit from '@/components/widgets/acepro/AceProRackUnit.vue'
+import AceProProgress from '@/components/widgets/acepro/AceProProgress.vue'
+import AceProHealth from '@/components/widgets/acepro/AceProHealth.vue'
+import AceProSlotDialog from '@/components/widgets/acepro/AceProSlotDialog.vue'
+import AceCutterWizard from '@/components/widgets/acepro/AceCutterWizard.vue'
+import AceProSettingsMenu from '@/components/widgets/acepro/AceProSettingsMenu.vue'
+import { aceUi } from '@/components/widgets/acepro/aceUi'
+
+@Component({
+  components: {
+    AceProRackUnit,
+    AceProProgress,
+    AceProHealth,
+    AceProSlotDialog,
+    AceCutterWizard,
+    AceProSettingsMenu
+  }
+})
+export default class Ace extends Mixins(AceProMixin) {
+  readonly aceUi = aceUi
+
+  dialog = { open: false, unit: 0, slot: 0 }
+
+  get endlessOn (): boolean {
+    return this.aceManager?.endless_spool_enabled === true
+  }
+
+  get endlessMode (): string {
+    return this.aceManager?.endless_spool_match_mode ?? 'exact'
+  }
+
+  get chains (): Array<{ tool: number, next: number[] }> {
+    return Object.entries(this.aceManager?.endless_chain ?? {})
+      .map(([tool, next]) => ({ tool: Number(tool), next }))
+      .sort((a, b) => a.tool - b.tool)
+  }
+
+  get toolMapText (): string {
+    return Object.entries(this.aceManager?.tool_map ?? {})
+      .map(([from, to]) => `T${from}→T${to}`)
+      .join(', ')
+  }
+
+  openSlotEntry (entry: { unit: number, slot: number }) {
+    this.dialog = { open: true, unit: entry.unit, slot: entry.slot }
+  }
+
+  async testCutter () {
+    const result = await this.$confirm('Move the toolhead to the cutter and cut the filament now?', {
+      title: 'Test the cutter',
+      color: 'card-heading',
+      icon: '$error'
+    })
+
+    if (result) this.aceSendGcode('CUT_TIP')
+  }
+}
+</script>
+
+<style lang="scss" scoped>
+.ace-page-actions > * {
+  margin: 0 6px 6px 0;
+}
+</style>
