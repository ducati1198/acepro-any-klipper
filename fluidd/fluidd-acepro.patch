+      slot.brand,
+      slot.custom_name && slot.custom_name !== slot.material ? slot.custom_name : undefined,
+      this.aceSlotIsRfid(slot) ? 'RFID' : undefined
+    ].filter(Boolean).join(' · ')
+  }
+
+  isSelected (unit: number, slot: number): boolean {
+    return this.selected?.unit === unit && this.selected?.slot === slot
+  }
+
+  select (unit: number, slot: number) {
+    this.selected = this.isSelected(unit, slot) ? null : { unit, slot }
+  }
+
+  tooltip (slot: AceSlotState): string {
+    return this.aceSlotIsEmpty(slot)
+      ? `T${slot.tool} · empty`
+      : `T${slot.tool} · ${this.aceSlotMaterial(slot)}${slot.temp ? ` · ${slot.temp}°C` : ''}`
+  }
+}
