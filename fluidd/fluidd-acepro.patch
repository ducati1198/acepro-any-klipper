+// Status shapes published by the acepro-any-klipper driver.
+// `ace` is the manager object; each unit is `ace_instance_<n>`.
+
+export interface AceManagerState {
+  ace_instances?: number;
+  current_index?: number;
+  endless_spool_enabled?: boolean;
+  endless_spool_match_mode?: AceEndlessSpoolMode;
+  ace_pro_enabled?: boolean;
+  toolhead_sensor?: boolean | null;
+  rdm_sensor?: boolean | null;
+  tool_map?: Record<string, number>;
+  tool_map_file?: string;
+  tool_map_active?: boolean;
+  target_index?: number;
+  toolchange_in_progress?: boolean;
+  endless_chain?: Record<string, number[]>;
+  stats?: AceStats;
+}
+
+export interface AceStats {
+  tool_changes?: number;
+  purge_mm?: number;
+  cuts?: number;
+}
+
+export type AceEndlessSpoolMode = 'exact' | 'material' | 'next'
+
+export interface AceDryerState {
+  status?: string;
+  target_temp?: number;
+  duration?: number;
+  remain_time?: number;
+}
+
+export interface AceSlotState {
+  index: number;
+  tool?: number;
+  status?: string;
+  color?: number[];
+  material?: string;
+  temp?: number;
+  rfid?: boolean | number;
+  sku?: string;
+  brand?: string;
+  custom_name?: string;
+}
+
+export interface AceInstanceState {
+  instance?: number;
+  status?: string;
+  model?: string;
+  firmware?: string;
+  protocol?: string;
+  usb_port?: string;
+  connection_state?: string;
+  rfid_sync_enabled?: boolean;
+  feed_assist_slot?: number;
+  temp?: number;
+  humidity?: number;
+  dryer?: AceDryerState;
+  dryer_status?: AceDryerState;
+  slots?: AceSlotState[];
+}
+
+export interface AceUnit {
+  index: number;
+  state: AceInstanceState;
+}
+
+export type AceFilamentPosition = 'bowden' | 'splitter' | 'toolhead' | 'nozzle' | string
