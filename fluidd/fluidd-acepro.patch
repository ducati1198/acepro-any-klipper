+    <template #activator="{ on, attrs }">
+      <app-btn
+        icon
+        small
+        v-bind="attrs"
+        v-on="on"
+      >
+        <v-icon dense>
+          $cog
+        </v-icon>
+      </app-btn>
+    </template>
+
+    <v-list dense>
+      <v-list-item
+        v-if="aceEnablePinName"
+        :disabled="!klippyReady"
+        @click="setEnabled(!aceEnabled)"
+      >
+        <v-list-item-action class="my-0">
+          <v-switch
+            :input-value="aceEnabled"
+            readonly
+            hide-details
+            dense
+          />
+        </v-list-item-action>
+        <v-list-item-title>ACE Pro support</v-list-item-title>
+      </v-list-item>
+
+      <v-list-item
+        :disabled="!klippyReady"
+        @click="toggleEndlessSpool"
+      >
+        <v-list-item-action class="my-0">
+          <v-switch
+            :input-value="endlessSpool"
+            readonly
+            hide-details
+            dense
+          />
+        </v-list-item-action>
+        <v-list-item-title>Endless spool</v-list-item-title>
+      </v-list-item>
+
+      <v-list-item v-if="endlessSpool">
+        <v-select
+          :value="endlessMode"
+          :items="endlessModes"
+          label="Match spool by"
+          dense
+          outlined
+          hide-details
+          class="my-1"
+          :disabled="!klippyReady"
+          @change="setEndlessMode"
+        />
+      </v-list-item>
+
+      <v-list-item
+        :disabled="!klippyReady"
+        @click="toggleRfid"
+      >
+        <v-list-item-action class="my-0">
+          <v-switch
+            :input-value="rfidSync"
+            readonly
+            hide-details
+            dense
+          />
+        </v-list-item-action>
+        <v-list-item-title>RFID inventory sync</v-list-item-title>
+      </v-list-item>
+
+      <v-divider class="my-1" />
+
+      <v-list-item
+        :disabled="!canMove"
+        @click="confirmRun('Feed every loaded slot to the toolhead sensor to check the inventory?', 'ACE_SMART_LOAD')"
+      >
+        <v-list-item-title>Smart load (verify all slots)</v-list-item-title>
+      </v-list-item>
+      <v-list-item
+        :disabled="!canMove"
+        @click="confirmRun('Unload whatever filament is in the toolhead, using the sensors to find it?', 'ACE_SMART_UNLOAD')"
+      >
+        <v-list-item-title>Smart unload</v-list-item-title>
+      </v-list-item>
+      <v-list-item
+        :disabled="!klippyReady || !aceEnabled"
+        @click="run('ACE_RECONNECT')"
+      >
+        <v-list-item-title>Reconnect ACE units</v-list-item-title>
+      </v-list-item>
+      <v-list-item
+        :disabled="!klippyReady || aceIsPrinting"
+        @click="confirmRun(resetText, 'ACE_RESET_ACTIVE_TOOLHEAD')"
+      >
+        <v-list-item-title class="error--text">
+          Reset active tool…
+        </v-list-item-title>
+      </v-list-item>
+    </v-list>
+  </v-menu>
+</template>
+
+<script lang="ts">
+import { Component, Mixins } from 'vue-property-decorator'
+import AceProMixin from './acepro'
+import type { AceEndlessSpoolMode } from './types'
+
+@Component
+export default class AceProSettingsMenu extends Mixins(AceProMixin) {
+  readonly endlessModes: Array<{ value: AceEndlessSpoolMode, text: string }> = [
+    { value: 'exact', text: 'Material and color' },
+    { value: 'material', text: 'Material only' },
+    { value: 'next', text: 'Next ready slot' }
+  ]
+
+  readonly resetText = 'Clear the loaded tool (set it to none) and filament position back to bowden? ' +
+    'Use only after an error, once all filament has been pulled back past the splitter.'
+
+  get endlessSpool (): boolean {
+    return this.aceManager?.endless_spool_enabled === true
+  }
+
+  get endlessMode (): AceEndlessSpoolMode {
+    return this.aceManager?.endless_spool_match_mode ?? 'exact'
+  }
+
+  get rfidSync (): boolean {
+    return this.aceUnits[0]?.state.rfid_sync_enabled === true
+  }
+
+  get canMove (): boolean {
+    return this.klippyReady && this.aceEnabled && !this.aceIsPrinting
+  }
+
+  run (gcode: string) {
+    this.aceSendGcode(gcode)
+  }
+
+  async confirmRun (text: string, gcode: string) {
+    const result = await this.$confirm(text, {
+      title: 'ACE Pro',
+      color: 'card-heading',
+      icon: '$error'
+    })
+
+    if (result) {
+      this.run(gcode)
+    }
+  }
+
+  setEnabled (enabled: boolean) {
+    if (this.aceEnablePinName) {
+      this.run(`SET_PIN PIN=${this.aceEnablePinName} VALUE=${enabled ? 1 : 0}`)
+    }
+  }
+
+  // Printers with an [output_pin endless_spool] toggle poll that pin and push it to
+  // the driver, so flip the pin instead of calling the driver directly.
+  get endlessSpoolPinName (): string | undefined {
+    return Object.keys(this.$typedState.printer.printer)
+      .find(key => key.toLowerCase() === 'output_pin endless_spool')
+      ?.substring('output_pin '.length)
+  }
+
+  toggleEndlessSpool () {
+    if (this.endlessSpoolPinName) {
+      this.run(`SET_PIN PIN=${this.endlessSpoolPinName} VALUE=${this.endlessSpool ? 0 : 1}`)
+    } else {
+      this.run(this.endlessSpool ? 'ACE_DISABLE_ENDLESS_SPOOL' : 'ACE_ENABLE_ENDLESS_SPOOL')
+    }
+  }
+
+  setEndlessMode (mode: AceEndlessSpoolMode) {
+    this.run(`ACE_SET_ENDLESS_SPOOL_MODE MODE=${mode}`)
+  }
+
+  toggleRfid () {
+    this.run(this.rfidSync ? 'ACE_DISABLE_RFID_SYNC' : 'ACE_ENABLE_RFID_SYNC')
+  }
+}
+</script>
