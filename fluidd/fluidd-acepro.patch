+
+<script lang="ts">
+import { Component, Mixins, Prop, VModel } from 'vue-property-decorator'
+import AceProMixin, { ACE_MATERIAL_TEMPS } from './acepro'
+import type { AceSlotState, AceUnit } from './types'
+
+@Component
+export default class AceProSlotDialog extends Mixins(AceProMixin) {
+  @VModel({ type: Boolean })
+  open!: boolean
+
+  @Prop({ type: Number, required: true })
+  readonly unitIndex!: number
+
+  @Prop({ type: Number, required: true })
+  readonly slotIndex!: number
+
+  material = ''
+  temp = 0
+  color = '#FF0000'
+  showPicker = false
+  moveLength = 50
+  moveSpeed = 25
+
+  readonly materials = Object.keys(ACE_MATERIAL_TEMPS)
+
+  readonly colorPresets = [
+    '#FFFFFF', '#000000', '#808080', '#FF0000', '#FF7F00', '#FFD700',
+    '#00A651', '#00BFFF', '#0047AB', '#8A2BE2', '#FF69B4', '#8B4513'
+  ]
+
+  created () {
+    const slot = this.slotState
+
+    this.material = this.aceSlotIsEmpty(slot) ? 'PLA' : (slot.material || 'PLA')
+    this.temp = slot.temp || ACE_MATERIAL_TEMPS[this.material] || 210
+    this.color = this.aceSlotIsEmpty(slot) ? '#FF0000' : this.aceSlotColor(slot).toUpperCase()
+  }
+
+  get unit (): AceUnit {
+    return this.aceUnits.find(u => u.index === this.unitIndex) ?? { index: this.unitIndex, state: {} }
+  }
+
+  get slotState (): AceSlotState {
+    return this.aceUnitSlots(this.unit)[this.slotIndex]
+  }
+
+  get tool (): number {
+    return this.slotState.tool ?? this.unitIndex * 4 + this.slotIndex
+  }
+
+  get title (): string {
+    const where = this.aceUnits.length > 1
+      ? `ACE ${this.unitIndex + 1}, slot ${this.slotIndex + 1}`
+      : `Slot ${this.slotIndex + 1}`
+
+    return `T${this.tool} · ${where}`
+  }
+
+  get empty (): boolean {
+    return this.aceSlotIsEmpty(this.slotState)
+  }
+
+  get rfid (): boolean {
+    return this.aceSlotIsRfid(this.slotState)
+  }
+
+  get isActive (): boolean {
+    return this.aceCurrentTool === this.tool
+  }
+
+  get feeding (): boolean {
+    return this.unit.state.feed_assist_slot === this.slotIndex
+  }
+
+  get canMove (): boolean {
+    return this.klippyReady && this.aceEnabled && !this.aceIsPrinting
+  }
+
+  get canAssist (): boolean {
+    return this.klippyReady && this.aceEnabled && !(this.aceIsPrinting && !this.feeding)
+  }
+
+  get moveBlockedReason (): string {
+    if (!this.klippyReady) return 'Klipper is not ready.'
+    if (!this.aceEnabled) return 'ACE Pro support is off — turn it on to move filament.'
+    if (this.aceIsPrinting) return 'Moves are locked while a print is running or paused.'
+    return ''
+  }
+
+  get validMove (): boolean {
+    return this.moveLength > 0 && this.moveLength <= 2000 && this.moveSpeed > 0 && this.moveSpeed <= 100
+  }
+
+  get canSave (): boolean {
+    return (
+      this.klippyReady &&
+      !!this.material?.trim() &&
+      Number.isFinite(this.temp) &&
+      this.temp >= 0 &&
+      this.temp <= 300 &&
+      /^#[0-9a-f]{6}$/i.test(this.color)
+    )
+  }
+
+  get rgb (): string {
+    const hex = this.color.substring(1)
+
+    return [0, 2, 4]
+      .map(offset => parseInt(hex.substring(offset, offset + 2), 16))
+      .join(',')
+  }
+
+  applyMaterialDefault (value: string | null) {
+    const key = (value ?? '').toUpperCase()
+
+    if (key in ACE_MATERIAL_TEMPS) {
+      this.temp = ACE_MATERIAL_TEMPS[key]
+    }
+  }
+
+  setColor (value: { hex: string }) {
+    this.color = value.hex.substring(0, 7).toUpperCase()
+  }
+
+  run (gcode: string, close = false) {
+    this.aceSendGcode(gcode)
+
+    if (close) {
+      this.open = false
+    }
+  }
+
+  save () {
+    if (!this.canSave) return
+
+    const material = this.material.trim().replace(/["\s]+/g, '_')
+
+    this.aceSendGcode(
+      `ACE_SET_SLOT INSTANCE=${this.unitIndex} INDEX=${this.slotIndex} MATERIAL="${material}" TEMP=${Math.round(this.temp)} COLOR="${this.rgb}"`
+    )
+    this.open = false
+  }
+
+  async markEmpty () {
+    const result = await this.$confirm(
+      `Mark T${this.tool} as empty? This only clears the saved filament info.`,
+      { title: 'Mark slot empty', color: 'card-heading', icon: '$error' }
+    )
+
+    if (result) {
+      this.aceSendGcode(`ACE_SET_SLOT INSTANCE=${this.unitIndex} INDEX=${this.slotIndex} EMPTY=1`)
+      this.open = false
+    }
+  }
+
+  async fullUnload () {
+    const result = await this.$confirm(
+      `Retract T${this.tool} all the way back into the ACE until the slot reads empty?`,
+      { title: 'Retract to ACE', color: 'card-heading', icon: '$error' }
+    )
+
+    if (result) {
+      this.aceSendGcode(`ACE_FULL_UNLOAD TOOL=${this.tool}`)
+      this.open = false
+    }
+  }
+}
+</script>
+
