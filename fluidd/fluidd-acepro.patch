+            @click="testCutter"
+          >
+            Test the cutter
+          </app-btn>
+          <app-btn
+            small
+            outlined
+            :disabled="!aceCanMove"
+            @click="aceSendGcode('SERVO_TEST ANGLE=90')"
+          >
+            Basket open
+          </app-btn>
+          <app-btn
+            small
+            outlined
+            :disabled="!aceCanMove"
+            @click="aceSendGcode('SERVO_TEST ANGLE=0')"
+          >
+            Basket close
+          </app-btn>
