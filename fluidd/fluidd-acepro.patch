@@ -0,0 +1,185 @@
+import { Component, Mixins } from 'vue-property-decorator'
+import StateMixin from '@/mixins/state'
+import type {
+  AceDryerState,
+  AceFilamentPosition,
+  AceManagerState,
+  AceSlotState,
+  AceUnit
+} from './types'
+
+export const ACE_SLOTS_PER_UNIT = 4
+
+export const ACE_MATERIAL_TEMPS: Record<string, number> = {
+  PLA: 210,
+  'PLA+': 215,
+  'PLA-CF': 220,
+  PETG: 240,
+  'PETG-CF': 250,
+  ABS: 250,
+  ASA: 255,
+  TPU: 225,
+  PA: 260,
+  'PA-CF': 270,
+  PC: 270,
+  PVA: 200,
+  HIPS: 230
+}
+
+const isObject = (value: unknown): value is Record<string, unknown> =>
+  value != null && typeof value === 'object' && !Array.isArray(value)
+
+@Component
+export default class AceProMixin extends Mixins(StateMixin) {
+  get aceManager (): AceManagerState | undefined {
+    const ace = this.$typedState.printer.printer.ace
+
+    return isObject(ace) && 'ace_instances' in ace
+      ? ace
+      : undefined
+  }
+
+  get aceSupported (): boolean {
+    return this.aceManager != null
+  }
+
+  get aceEnabled (): boolean {
+    return this.aceManager?.ace_pro_enabled === true
+  }
+
+  get aceUnits (): AceUnit[] {
+    const printer = this.$typedState.printer.printer
+    const count = Math.max(1, this.aceManager?.ace_instances ?? 1)
+    const units: AceUnit[] = []
+
+    for (let index = 0; index < count; index++) {
+      const state = printer[`ace_instance_${index}`]
+
+      units.push({
+        index,
+        state: isObject(state) ? state : {}
+      })
+    }
+
+    return units
+  }
+
+  get aceCurrentTool (): number {
+    const value = this.aceManager?.current_index
+
+    return typeof value === 'number' ? value : -1
+  }
+
+  get aceSaveVariables (): Record<string, unknown> {
+    const variables = this.$typedState.printer.printer.save_variables?.variables
+
+    return isObject(variables) ? variables : {}
+  }
+
+  get aceFilamentPosition (): AceFilamentPosition {
+    const value = this.aceSaveVariables.ace_filament_pos
+
+    return typeof value === 'string' ? value : 'unknown'
+  }
+
+  get aceIsPrinting (): boolean {
+    const state = this.$typedState.printer.printer.print_stats?.state
+
+    return state === 'printing' || state === 'paused'
+  }
+
+  get aceEnablePinName (): string | undefined {
+    const printer = this.$typedState.printer.printer
+
+    return Object.keys(printer)
+      .find(key => key.toLowerCase() === 'output_pin ace_pro')
+      ?.substring('output_pin '.length)
+  }
+
+  aceUnitSlots (unit: AceUnit): AceSlotState[] {
+    const slots = Array.isArray(unit.state.slots) ? unit.state.slots : []
+    const result: AceSlotState[] = []
+
+    for (let index = 0; index < ACE_SLOTS_PER_UNIT; index++) {
+      const slot = slots.find(s => s?.index === index)
+
+      result.push({
+        index,
+        tool: unit.index * ACE_SLOTS_PER_UNIT + index,
+        status: 'unknown',
+        ...slot
+      })
+    }
+
+    return result
+  }
+
+  aceUnitDryer (unit: AceUnit): AceDryerState {
+    return unit.state.dryer_status ?? unit.state.dryer ?? { status: 'stop' }
+  }
+
+  aceIsDrying (dryer: AceDryerState): boolean {
+    return dryer.status != null && !['stop', 'stopped', 'idle', 'unknown'].includes(dryer.status)
+  }
+
+  /**
+   * The ACE Pro reports remain_time in minutes, ACE 2 in seconds.
+   * Anything larger than the requested duration must already be seconds.
+   */
+  aceDryerRemainingSeconds (dryer: AceDryerState): number {
+    const remain = Math.max(0, dryer.remain_time ?? 0)
+    const duration = dryer.duration ?? 0
+
+    if (duration > 0) {
+      return remain > duration + 1 ? remain : remain * 60
+    }
+
+    return remain < 1000 ? remain * 60 : remain
+  }
+
+  aceUnitConnected (unit: AceUnit): boolean {
+    return unit.state.connection_state === 'connected'
+  }
+
+  aceSlotIsEmpty (slot: AceSlotState): boolean {
+    return slot.status === 'empty'
+  }
+
+  aceSlotIsRfid (slot: AceSlotState): boolean {
+    return slot.rfid === true || slot.rfid === 1 || slot.rfid === 2
+  }
+
+  aceSlotColor (slot: AceSlotState): string {
+    const color = slot.color
+
+    if (!Array.isArray(color) || color.length < 3 || this.aceSlotIsEmpty(slot)) {
+      return '#5a5a5a'
+    }
+
+    return '#' + color
+      .slice(0, 3)
+      .map(c => Math.max(0, Math.min(255, Math.round(Number(c) || 0))).toString(16).padStart(2, '0'))
+      .join('')
+  }
+
+  aceSlotMaterial (slot: AceSlotState): string {
+    return slot.custom_name || slot.material || (this.aceSlotIsEmpty(slot) ? '' : 'Unknown')
+  }
+
+  /** Every slot of every unit as a flat list (tool order). */
+  get aceAllSlots (): Array<{ unit: AceUnit, slot: AceSlotState }> {
+    return this.aceUnits.flatMap(unit => this.aceUnitSlots(unit).map(slot => ({ unit, slot })))
+  }
+
+  get aceToolchangeActive (): boolean {
+    return this.aceManager?.toolchange_in_progress === true
+  }
+
+  get aceCanMove (): boolean {
+    return this.klippyReady && this.aceEnabled && !this.aceIsPrinting
+  }
+
+  aceSendGcode (gcode: string) {
+    this.sendGcode(gcode)
+  }
+}
