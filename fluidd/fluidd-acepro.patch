+<template>
+  <div
+    class="ace-slot rounded text-center py-1"
+    :class="{ 'ace-slot--active': active, 'ace-slot--empty': empty }"
+    role="button"
+    tabindex="0"
+    :title="tooltip"
+    @click="$emit('click')"
+    @keydown.enter="$emit('click')"
+  >
+    <div class="text-caption font-weight-bold">
+      T{{ slotState.tool }}
+    </div>
+    <div
+      class="text-overline ace-slot__status"
+      :class="statusClass"
+    >
+      {{ statusLabel }}
+    </div>
+
+    <svg
+      viewBox="0 0 64 64"
+      class="ace-spool"
+      :class="{ 'ace-spool--feeding': feeding }"
+    >
+      <circle
+        cx="32"
+        cy="32"
+        r="29"
+        :fill="empty ? 'transparent' : color"
+        :stroke="empty ? '#888' : 'rgba(0,0,0,0.35)'"
+        stroke-width="2"
+        :stroke-dasharray="empty ? '4 3' : undefined"
+      />
+      <circle
+        v-if="!empty"
+        cx="32"
+        cy="32"
+        r="20"
+        fill="none"
+        stroke="rgba(0,0,0,0.18)"
+        stroke-width="1"
+      />
+      <circle
+        cx="32"
+        cy="32"
+        r="11"
+        :fill="hubColor"
+        stroke="rgba(0,0,0,0.4)"
+        stroke-width="1"
+      />
+      <circle
+        cx="32"
+        cy="32"
+        r="4"
+        fill="rgba(0,0,0,0.6)"
+      />
+    </svg>
+
+    <div class="text-caption font-weight-bold text-truncate px-1">
+      {{ empty ? '---' : material }}
+      <v-icon
+        v-if="rfid"
+        x-small
+        title="Read from RFID tag"
+      >
+        {{ icons.nfc }}
+      </v-icon>
+    </div>
+    <div class="text-caption secondary--text">
+      {{ empty || !slotState.temp ? '--' : `${slotState.temp}°C` }}
+    </div>
+  </div>
+</template>
+
+<script lang="ts">
+import { Component, Mixins, Prop } from 'vue-property-decorator'
+import { mdiNfcVariant } from '@mdi/js'
+import AceProMixin from './acepro'
+import type { AceSlotState } from './types'
+
+@Component
+export default class AceProSlot extends Mixins(AceProMixin) {
+  @Prop({ type: Object, required: true })
+  readonly slotState!: AceSlotState
+
+  @Prop({ type: Boolean })
+  readonly active?: boolean
+
+  @Prop({ type: Boolean })
+  readonly feeding?: boolean
+
+  readonly icons = { nfc: mdiNfcVariant }
+
+  get empty (): boolean {
+    return this.aceSlotIsEmpty(this.slotState)
+  }
+
+  get color (): string {
+    return this.aceSlotColor(this.slotState)
+  }
+
+  get hubColor (): string {
+    return this.$vuetify.theme.dark ? '#2b2b2b' : '#e0e0e0'
+  }
+
+  get material (): string {
+    return this.aceSlotMaterial(this.slotState)
+  }
+
+  get rfid (): boolean {
+    return this.aceSlotIsRfid(this.slotState)
+  }
+
+  get statusLabel (): string {
+    if (this.active) return 'loaded'
+    if (this.feeding) return 'feeding'
+    return this.slotState.status || 'unknown'
+  }
+
+  get statusClass (): string {
+    if (this.active) return 'primary--text'
+    if (this.feeding) return 'orange--text'
+    if (this.empty) return 'grey--text'
+    if (this.slotState.status === 'ready') return 'success--text'
+    return 'warning--text'
+  }
+
+  get tooltip (): string {
+    const parts = [`T${this.slotState.tool}`, this.material, this.slotState.brand, this.slotState.sku]
+      .filter(Boolean)
+
+    return `${parts.join(' · ')} — click to edit or move`
+  }
+}
+</script>
+
+<style lang="scss" scoped>
+.ace-slot {
+  cursor: pointer;
+  border: 2px solid transparent;
+  transition: border-color 0.15s, background-color 0.15s;
+}
+
+.ace-slot:hover,
+.ace-slot:focus-visible {
+  background-color: rgba(128, 128, 128, 0.12);
+  outline: none;
+}
+
+.ace-slot--active {
+  border-color: var(--v-primary-base);
+}
+
+.ace-slot__status {
+  line-height: 1.2;
+  letter-spacing: 0.05em !important;
+}
+
+.ace-spool {
+  width: 56px;
+  max-width: 100%;
+  height: auto;
+  margin: 2px auto;
+  display: block;
+}
+
+.ace-spool--feeding {
+  animation: ace-spin 3s linear infinite;
+}
+
+@keyframes ace-spin {
+  to { transform: rotate(-360deg); }
+}
+</style>
