+<script lang="ts">
+import { Component, Mixins } from 'vue-property-decorator'
+import AceProMixin from './acepro'
+import AceProDryer from './AceProDryer.vue'
+import type { AceSlotState, AceUnit } from './types'
+
+@Component({
+  components: { AceProDryer }
+})
+export default class AceProStrip extends Mixins(AceProMixin) {
+  selected: { unit: number, slot: number } | null = null
+  showDryers = false
+
+  get selectedEntry (): { unit: AceUnit, slot: AceSlotState } | undefined {
+    const sel = this.selected
+
+    return sel == null
+      ? undefined
+      : this.aceAllSlots.find(entry => entry.unit.index === sel.unit && entry.slot.index === sel.slot)
+  }
+
+  get selectedEmpty (): boolean {
+    return this.selectedEntry != null && this.aceSlotIsEmpty(this.selectedEntry.slot)
+  }
+
+  get dryingCount (): number {
+    return this.aceUnits.filter(unit => this.aceIsDrying(this.aceUnitDryer(unit))).length
+  }
+
+  get details (): string {
+    const slot = this.selectedEntry?.slot
+
+    if (!slot) return ''
+    return [
