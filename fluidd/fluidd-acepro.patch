+        :disabled="!metadataLoaded || busy"
+        title="Ignore the picker and use T0, T1… exactly as sliced"
+        @click="startPrint(false)"
+      >
+        Print as sliced
+      </app-btn>
+      <app-btn
+        color="primary"
+        type="submit"
+        :loading="busy"
+        :disabled="!metadataLoaded || readySlots.length === 0"
+      >
+        Print
+      </app-btn>
+    </template>
+  </app-dialog>
+</template>
+
+<script lang="ts">
+import { Component, Mixins, Watch } from 'vue-property-decorator'
+import AceProMixin from './acepro'
+import FilesMixin from '@/mixins/files'
+import { SocketActions } from '@/api/socketActions'
+import getFilePaths from '@/util/get-file-paths'
+import { encodeGcodeParamValue } from '@/util/gcode-helpers'
+import type { AppFile, AppFileWithMeta } from '@/store/files/types'
+import type { AceSlotState } from './types'
+import { acePrintStartState } from './printStartState'
+
+interface SourceRow {
+  tool: number;
+  color: string;
+  type: string;
+  name: string;
+  weight: number;
+}
+
+interface SlotItem {
+  tool: number;
+  text: string;
+  color: string;
+  material: string;
+  disabled: boolean;
+  slot: AceSlotState;
+}
+
+const normalizeMaterial = (value: string | undefined) => (value ?? '')
+  .toUpperCase()
+  .replace(/[\s_]+/g, '')
+  .replace(/^PA(?=$|[-+])/, 'NYLON')
+
+const hexToRgb = (hex: string): [number, number, number] | null => {
+  const match = /^#?([0-9a-f]{6})/i.exec(hex.trim())
+
+  if (!match) return null
+
+  const value = parseInt(match[1], 16)
+
+  return [(value >> 16) & 255, (value >> 8) & 255, value & 255]
+}
+
+// Rough perceptual RGB distance (0 = same, ~765 = opposite)
+const colorDistance = (a: string, b: string): number => {
+  const ca = hexToRgb(a)
+  const cb = hexToRgb(b)
+
+  if (!ca || !cb) return 400
+
+  const rMean = (ca[0] + cb[0]) / 2
+  const dr = ca[0] - cb[0]
+  const dg = ca[1] - cb[1]
+  const db = ca[2] - cb[2]
+
+  return Math.sqrt((2 + rMean / 256) * dr * dr + 4 * dg * dg + (2 + (255 - rMean) / 256) * db * db)
+}
+
+@Component
+export default class AcePrintStartDialog extends Mixins(AceProMixin, FilesMixin) {
+  mapping: Record<number, number> = {}
+  busy = false
+
+  get open (): boolean {
+    return acePrintStartState.show
+  }
+
+  set open (value: boolean) {
+    acePrintStartState.show = value
+  }
+
+  get filename (): string {
+    return acePrintStartState.filename
+  }
+
+  get shortFilename (): string {
+    return this.filename ? getFilePaths(this.filename, 'gcodes').filename : ''
+  }
+
+  get currentFile (): AppFile | AppFileWithMeta | undefined {
+    if (!this.filename) return undefined
+
+    const { filename, rootPath } = getFilePaths(this.filename, 'gcodes')
+
+    return this.$typedGetters['files/getFile'](rootPath, filename)
+  }
+
+  get meta (): Partial<AppFileWithMeta> {
+    return (this.currentFile ?? {}) as Partial<AppFileWithMeta>
+  }
+
+  get metadataLoaded (): boolean {
+    const file = this.currentFile
+
+    return file != null && ('estimated_time' in file || 'filament_colors' in file || 'slicer' in file)
+  }
+
+  get thumbnailUrl (): string {
+    if (!this.currentFile || !this.filename) return ''
+
+    const { path } = getFilePaths(this.filename, 'gcodes')
+
+    return this.getThumbUrl(this.currentFile, 'gcodes', path, true, this.currentFile.modified) ?? ''
+  }
+
+  get usedTools (): number[] {
+    const file = this.meta
+
+    if (Array.isArray(file.referenced_tools) && file.referenced_tools.length > 0) {
+      return [...file.referenced_tools].sort((a, b) => a - b)
+    }
+
+    const weights = Array.isArray(file.filament_weights) ? file.filament_weights : []
+    const byWeight = weights
+      .map((weight, index) => (weight > 0 ? index : -1))
+      .filter(index => index >= 0)
+
+    if (byWeight.length > 0) return byWeight
+
+    const colors = Array.isArray(file.filament_colors) ? file.filament_colors : []
+
+    return colors.length === 1 || colors.length === 0 ? [0] : colors.map((_, index) => index)
+  }
+
+  get rows (): SourceRow[] {
+    const file = this.meta
+    const colors = Array.isArray(file.filament_colors) ? file.filament_colors : []
+    const types = Array.isArray(file.filament_type) ? file.filament_type : []
+    const names = Array.isArray(file.filament_name) ? file.filament_name : []
+    const weights = Array.isArray(file.filament_weights) ? file.filament_weights : []
+    const pick = <T>(list: T[], index: number): T | undefined => list[index] ?? (list.length === 1 ? list[0] : undefined)
+
+    return this.usedTools.map(tool => ({
+      tool,
+      color: String(pick(colors, tool) ?? ''),
+      type: String(pick(types, tool) ?? ''),
+      name: String(pick(names, tool) ?? ''),
+      weight: Math.round(Number(weights[tool] ?? 0))
+    }))
+  }
+
+  get allSlots (): SlotItem[] {
+    return this.aceUnits.flatMap(unit => this.aceUnitSlots(unit).map(slot => {
+      const empty = this.aceSlotIsEmpty(slot)
+      const material = this.aceSlotMaterial(slot)
+      const where = this.aceUnits.length > 1 ? ` (ACE ${unit.index + 1})` : ''
+
+      return {
+        tool: slot.tool ?? 0,
+        text: `T${slot.tool} · ${empty ? 'empty' : material}${slot.temp && !empty ? ` · ${slot.temp}°C` : ''}${where}`,
+        color: this.aceSlotColor(slot),
+        material,
+        disabled: empty,
+        slot
+      }
+    }))
+  }
+
+  get slotItems (): SlotItem[] {
+    return this.allSlots
+  }
+
+  get readySlots (): SlotItem[] {
+    return this.allSlots.filter(slot => !slot.disabled)
+  }
+
+  slotFor (tool: number): SlotItem | undefined {
+    return this.allSlots.find(slot => slot.tool === tool)
+  }
+
+  score (row: SourceRow, slot: SlotItem): number {
+    const materialMatch = !row.type || normalizeMaterial(row.type) === normalizeMaterial(slot.material)
+
+    return (materialMatch ? 0 : 1000) + (row.color ? colorDistance(row.color, slot.color) : 0)
+  }
+
+  autoMatch () {
+    const mapping: Record<number, number> = {}
+    const used = new Set<number>()
+
+    for (const row of this.rows) {
+      const candidates = [...this.readySlots]
+        .sort((a, b) =>
+          (this.score(row, a) + (used.has(a.tool) ? 500 : 0) + (a.tool === row.tool ? -1 : 0)) -
+          (this.score(row, b) + (used.has(b.tool) ? 500 : 0) + (b.tool === row.tool ? -1 : 0))
+        )
+
+      const best = candidates[0]?.tool ?? row.tool
+
+      mapping[row.tool] = best
+      used.add(best)
+    }
+
+    this.mapping = mapping
+  }
+
+  setMapping (tool: number, target: number) {
+    this.mapping = { ...this.mapping, [tool]: target }
+  }
+
+  rowWarnings (row: SourceRow): string[] {
+    const target = this.mapping[row.tool]
+    const slot = target != null ? this.slotFor(target) : undefined
+    const warnings: string[] = []
+
+    if (!slot || slot.disabled) {
+      warnings.push('This slot is empty.')
+      return warnings
+    }
+
+    if (row.type && normalizeMaterial(row.type) !== normalizeMaterial(slot.material)) {
+      warnings.push(`Sliced for ${row.type}, spool is ${slot.material || 'unknown'}.`)
+    }
+
+    if (row.color && colorDistance(row.color, slot.color) > 250) {
+      warnings.push('Color differs from the sliced color.')
+    }
+
+    const shared = this.rows.filter(other => other.tool !== row.tool && this.mapping[other.tool] === target)
+
+    if (shared.length > 0) {
+      warnings.push(`Same spool as ${shared.map(other => `T${other.tool}`).join(', ')}.`)
+    }
+
+    return warnings
+  }
+
+  get mapString (): string {
+    return Object.entries(this.mapping)
+      .filter(([from, to]) => Number(from) !== to)
+      .map(([from, to]) => `${from}:${to}`)
+      .join(',')
+  }
+
+  async startPrint (useMapping: boolean) {
+    if (!this.filename || this.busy) return
+
+    this.busy = true
+
+    try {
+      // Always record the choice for this file (an empty MAP = "as sliced"), so a map that the
+      // OrcaSlicer plugin embedded in the G-code (KEEP_EXISTING=1) does not override it.
+      const gcode = `ACE_SET_TOOL_MAP MAP=${useMapping ? this.mapString : ''} FILE=${encodeGcodeParamValue(this.filename)}`
+
+      this.addConsoleEntry(gcode)
+      await SocketActions.printerGcodeScript(gcode)
+      await SocketActions.printerPrintStart(this.filename)
+
+      if (this.$route.name !== 'home') {
+        this.$router.push({ name: 'home' })
+      }
+
+      this.open = false
+    } finally {
+      this.busy = false
+    }
+  }
+
+  @Watch('open')
+  onOpen (value: boolean) {
+    if (!value) return
+
+    this.mapping = {}
+
+    if (this.filename && !this.metadataLoaded) {
+      SocketActions.serverFilesMetadata(this.filename)
+    }
+
+    if (this.metadataLoaded) {
+      this.autoMatch()
+    }
+  }
+
+  @Watch('metadataLoaded')
+  onMetadataLoaded (value: boolean) {
+    if (value && this.open && Object.keys(this.mapping).length === 0) {
+      this.autoMatch()
+    }
+  }
+}
+</script>
+
+<style lang="scss" scoped>
+.ace-thumb {
+  background-color: rgba(0, 0, 0, 0.5);
+}
+
+.ace-map-row + .ace-map-row {
+  border-top: thin solid rgba(128, 128, 128, 0.2);
+}
+
+.ace-map-source {
+  width: 42%;
+  min-width: 0;
+}
+
+.ace-dot {
+  flex: 0 0 auto;
+  width: 22px;
+  height: 22px;
+  border-radius: 50%;
+  border: 1px solid rgba(128, 128, 128, 0.7);
+}
+
+.ace-dot--small {
+  width: 14px;
+  height: 14px;
+}
+</style>
