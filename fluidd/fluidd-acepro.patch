+            @slot-click="openSlot(unit.index, $event)"
+          />
+        </template>
+        <ace-pro-strip
+          v-else-if="layout === 'strip'"
+          @slot-click="openSlotEntry"
+        />
+        <ace-pro-rack
+          v-else-if="layout === 'rack'"
+          @slot-click="openSlotEntry"
+        />
+        <ace-pro-table
+          v-else
+          @slot-click="openSlotEntry"
+        />
+      </div>
+    </v-card-text>
+
+    <ace-pro-slot-dialog
+      v-if="dialog.open"
+      v-model="dialog.open"
+      :unit-index="dialog.unit"
+      :slot-index="dialog.slot"
+    />
+    <ace-cutter-wizard
+      v-if="aceUi.cutterWizard"
+      v-model="aceUi.cutterWizard"
+    />
+    <ace-pro-health-dialog
+      v-if="aceUi.health"
+      v-model="aceUi.health"
+    />
+  </collapsable-card>
+</template>
+
+<script lang="ts">
+import { Component, Mixins } from 'vue-property-decorator'
+import AceProMixin from './acepro'
+import AceProUnit from './AceProUnit.vue'
+import AceProSlotDialog from './AceProSlotDialog.vue'
+import AceProSettingsMenu from './AceProSettingsMenu.vue'
+import AceProStrip from './AceProStrip.vue'
+import AceProRack from './AceProRack.vue'
+import AceProTable from './AceProTable.vue'
+import AceProProgress from './AceProProgress.vue'
+import AceCutterWizard from './AceCutterWizard.vue'
+import AceProHealthDialog from './AceProHealthDialog.vue'
+import { mdiDotsHorizontal, mdiServer, mdiTable, mdiViewGrid } from '@mdi/js'
+import { aceUi, setAceLayout, type AceLayout } from './aceUi'
+
+const POSITION_LABELS: Record<string, string> = {
+  bowden: 'in bowden (unloaded)',
+  splitter: 'at splitter',
+  toolhead: 'at toolhead',
+  nozzle: 'in nozzle'
+}
+
+@Component({
+  components: {
+    AceProUnit,
+    AceProSlotDialog,
+    AceProSettingsMenu,
+    AceProStrip,
+    AceProRack,
+    AceProTable,
+    AceProProgress,
+    AceCutterWizard,
+    AceProHealthDialog
+  }
+})
+export default class AceProCard extends Mixins(AceProMixin) {
+  dialog = {
+    open: false,
+    unit: 0,
+    slot: 0
+  }
+
+  readonly aceUi = aceUi
+  readonly setAceLayout = setAceLayout
+
+  readonly layouts: Array<{ id: AceLayout, title: string, icon: string }> = [
+    { id: 'grid', title: 'Cards', icon: mdiViewGrid },
+    { id: 'strip', title: 'Compact strip', icon: mdiDotsHorizontal },
+    { id: 'rack', title: 'Spool rack', icon: mdiServer },
+    { id: 'table', title: 'Table', icon: mdiTable }
+  ]
+
+  get layout (): AceLayout {
+    return aceUi.layout
+  }
+
+  get positionLabel (): string {
+    return POSITION_LABELS[this.aceFilamentPosition] ?? this.aceFilamentPosition
+  }
+
+  get sensors () {
+    const describe = (name: string, value: boolean | null | undefined) => ({
+      name,
+      label: value == null ? 'n/a' : value ? 'filament' : 'empty',
+      color: value == null ? undefined : value ? 'success' : 'grey'
+    })
+
+    return [
+      describe('Toolhead', this.aceManager?.toolhead_sensor),
+      describe('Splitter', this.aceManager?.rdm_sensor)
+    ].filter(sensor => sensor.label !== 'n/a')
+  }
+
+  get toolMapText (): string {
+    const map = this.aceManager?.tool_map ?? {}
+
+    return Object.entries(map)
+      .map(([from, to]) => `T${from}→T${to}`)
+      .join(', ')
+  }
+
+  get canMove (): boolean {
+    return this.klippyReady && this.aceEnabled && !this.aceIsPrinting
+  }
+
+  openSlot (unit: number, slot: number) {
+    this.dialog = { open: true, unit, slot }
+  }
+
+  openSlotEntry (entry: { unit: number, slot: number }) {
+    this.openSlot(entry.unit, entry.slot)
+  }
+
+  refresh () {
+    this.aceSendGcode('ACE_QUERY_SLOTS')
+  }
+
+  setEnabled (enabled: boolean) {
+    if (this.aceEnablePinName) {
+      this.aceSendGcode(`SET_PIN PIN=${this.aceEnablePinName} VALUE=${enabled ? 1 : 0}`)
+    }
+  }
+
+  async unloadCurrent () {
+    const result = await this.$confirm(
+      `Unload T${this.aceCurrentTool} back to the ACE?`,
+      { title: 'Unload tool', color: 'card-heading', icon: '$error' }
+    )
+
+    if (result) {
+      this.aceSendGcode('TR')
+    }
+  }
+}
+</script>
+
+<style lang="scss" scoped>
+.ace-status-row :deep(.v-chip) {
+  text-transform: none;
+}
+
+.ace-layout-toggle {
+  background: transparent !important;
+}
+</style>
diff --git a/src/components/widgets/acepro/AceProDryer.vue b/src/components/widgets/acepro/AceProDryer.vue
new file mode 100644
index 0000000..bd8cf9f
--- /dev/null
+++ b/src/components/widgets/acepro/AceProDryer.vue
@@ -0,0 +1,212 @@
+<template>
+  <div class="d-flex align-center flex-wrap ace-dryer">
+    <v-icon
+      class="mr-2"
+      :color="drying ? 'orange' : undefined"
+    >
+      $fan
+    </v-icon>
+    <span
+      v-if="!compact"
+      class="text-subtitle-1 font-weight-medium mr-2"
+    >Dryer</span>
+    <v-chip
+      small
+      label
+      :color="drying ? 'orange' : undefined"
+      :class="{ 'ace-pulse': drying }"
+      class="mr-2"
+    >
+      {{ drying ? `${dryer.target_temp || '?'}°C · ${remainingLabel} left` : 'Idle' }}
+    </v-chip>
+    <v-spacer />
+
+    <template v-if="!drying">
+      <v-menu
+        offset-y
+        left
+      >
+        <template #activator="{ on, attrs }">
+          <app-btn
+            small
+            outlined
+            color="primary"
+            class="mr-1"
+            :disabled="!canUse"
+            v-bind="attrs"
+            v-on="on"
+          >
+            Presets
+            <v-icon
+              x-small
+              right
+            >
+              {{ icons.chevron }}
+            </v-icon>
+          </app-btn>
+        </template>
+        <v-list dense>
+          <v-list-item
+            v-for="preset in presets"
+            :key="`dry-preset:${preset.id}`"
+            @click="applyPreset(preset)"
+          >
+            <v-list-item-title>
+              {{ preset.label }}
+              <span class="text-body-2 ml-1">
+                {{ preset.temp }}°C · {{ formatMinutes(preset.minutes) }}
+              </span>
+              <v-chip
+                v-if="suggested && suggested.id === preset.id"
+                x-small
+                label
+                color="primary"
+                class="ml-1"
+              >
+                for this unit
+              </v-chip>
+            </v-list-item-title>
+          </v-list-item>
+        </v-list>
+      </v-menu>
+
+      <v-select
+        v-model="dryTemp"
+        :items="tempOptions"
+        suffix="°C"
+        dense
+        outlined
+        hide-details
+        class="ace-compact-select mr-1"
+      />
+      <v-select
+        v-model="dryDuration"
+        :items="durationOptions"
+        dense
+        outlined
+        hide-details
+        class="ace-compact-select mr-1"
+      />
+    </template>
+
+    <app-btn
+      small
+      :color="drying ? 'error' : 'primary'"
+      :disabled="!canUse"
+      @click="toggleDryer"
+    >
+      {{ drying ? 'Stop' : 'Dry' }}
+    </app-btn>
+  </div>
+</template>
+
+<script lang="ts">
+import { Component, Mixins, Prop } from 'vue-property-decorator'
+import { mdiChevronDown } from '@mdi/js'
+import AceProMixin from './acepro'
+import { ACE_DRY_PRESETS, dryPresetFor, formatMinutes, type AceDryPreset } from './aceUi'
+import type { AceDryerState, AceUnit } from './types'
+
+@Component
+export default class AceProDryer extends Mixins(AceProMixin) {
+  @Prop({ type: Object, required: true })
+  readonly unit!: AceUnit
+
+  @Prop({ type: Boolean })
+  readonly compact?: boolean
+
+  dryTemp = 50
+  dryDuration = 240
+
+  readonly icons = { chevron: mdiChevronDown }
+  readonly presets = ACE_DRY_PRESETS
+  readonly formatMinutes = formatMinutes
+  readonly tempOptions = [35, 40, 45, 50, 55, 60, 65]
+
+  readonly durationOptions = [30, 60, 120, 180, 240, 360, 480, 720]
+    .map(value => ({ value, text: value < 60 ? `${value} min` : `${value / 60} h` }))
+
+  get dryer (): AceDryerState {
+    return this.aceUnitDryer(this.unit)
+  }
+
+  get drying (): boolean {
+    return this.aceIsDrying(this.dryer)
+  }
+
+  get canUse (): boolean {
+    return this.klippyReady && this.aceUnitConnected(this.unit)
+  }
+
+  /** The gentlest preset that is safe for every spool in this unit. */
+  get suggested (): AceDryPreset | undefined {
+    const found = this.aceUnitSlots(this.unit)
+      .filter(slot => !this.aceSlotIsEmpty(slot))
+      .map(slot => dryPresetFor(slot.material))
+      .filter((preset): preset is AceDryPreset => preset != null)
+
+    return found.sort((a, b) => a.temp - b.temp)[0]
+  }
+
+  get remainingLabel (): string {
+    const total = this.aceDryerRemainingSeconds(this.dryer)
+    const hours = Math.floor(total / 3600)
+    const minutes = Math.floor((total % 3600) / 60)
+
+    return hours > 0
+      ? `${hours}h ${minutes.toString().padStart(2, '0')}m`
+      : `${minutes}m`
+  }
+
+  created () {
+    if (this.suggested) this.applyPreset(this.suggested)
+  }
+
+  applyPreset (preset: AceDryPreset) {
+    this.dryTemp = preset.temp
+    this.dryDuration = preset.minutes
+  }
+
+  async toggleDryer () {
+    const instance = this.unit.index
+
+    if (this.drying) {
+      const result = await this.$confirm(
+        'Stop drying? This turns off the ACE heater and fans.',
+        { title: 'Stop dryer', color: 'card-heading', icon: '$error' }
+      )
+
+      if (result) {
+        this.aceSendGcode(`ACE_STOP_DRYING INSTANCE=${instance}`)
+      }
+      return
+    }
+
+    this.aceSendGcode(`ACE_START_DRYING INSTANCE=${instance} TEMP=${this.dryTemp} DURATION=${this.dryDuration}`)
+  }
+}
+</script>
+
+<style lang="scss" scoped>
+.ace-compact-select {
+  max-width: 124px;
+  font-size: 1rem;
+}
+
+.ace-compact-select :deep(.v-input__slot) {
+  min-height: 40px !important;
+}
+
+.ace-compact-select :deep(.v-input__append-inner) {
+  margin-top: 6px !important;
+}
+
+.ace-pulse {
+  animation: ace-pulse 2s infinite ease-in-out;
+}
+
+@keyframes ace-pulse {
+  0%, 100% { opacity: 1; }
+  50% { opacity: 0.8; }
+}
+</style>
