+++ b/src/components/widgets/acepro/AceProRack.vue
@@ -0,0 +1,21 @@
+<template>
+  <div class="ace-rack-list">
+    <ace-pro-rack-unit
+      v-for="unit in aceUnits"
+      :key="`rack-unit:${unit.index}`"
+      :unit="unit"
+      @slot-click="$emit('slot-click', $event)"
+    />
+  </div>
+</template>
+
+<script lang="ts">
+import { Component, Mixins } from 'vue-property-decorator'
+import AceProMixin from './acepro'
+import AceProRackUnit from './AceProRackUnit.vue'
+
+@Component({
+  components: { AceProRackUnit }
+})
