+            label="Length"
+            suffix="mm"
+            type="number"
+            :min="1"
+            dense
+            outlined
+            hide-details
+          />
+        </v-col>
+        <v-col cols="3">
+          <v-text-field
+            v-model.number="moveSpeed"
+            label="Speed"
+            suffix="mm/s"
+            type="number"
+            :min="1"
+            dense
+            outlined
+            hide-details
+          />
+        </v-col>
+        <v-col
+          cols="5"
+          class="d-flex"
+        >
+          <app-btn
+            small
+            outlined
+            color="success"
+            class="mr-1"
+            :disabled="!canMove || !validMove"
+            @click="run(`ACE_FEED T=${tool} LENGTH=${moveLength} SPEED=${moveSpeed}`)"
+          >
+            Feed
+          </app-btn>
+          <app-btn
+            small
+            outlined
+            color="error"
+            :disabled="!canMove || !validMove"
+            @click="run(`ACE_RETRACT T=${tool} LENGTH=${moveLength} SPEED=${moveSpeed}`)"
+          >
+            Retract
+          </app-btn>
+        </v-col>
+      </v-row>
+      <div class="d-flex mt-1 mb-3">
+        <app-btn
+          small
+          text
+          color="primary"
