+<template>
+  <app-dialog
+    v-model="open"
+    :title="title"
+    width="460"
+    save-button-text="Save filament"
+    :save-button-disabled="!canSave"
+    @save="save"
+  >
+    <v-card-text class="pb-0">
+      <v-alert
+        v-if="rfid"
+        dense
+        text
+        type="info"
+        class="text-caption mb-3"
+      >
+        This spool was read from its RFID tag
+        <template v-if="slotState.brand || slotState.sku">
+          ({{ [slotState.brand, slotState.sku].filter(Boolean).join(' · ') }})
+        </template>.
+        Saving here overrides it until the spool is swapped.
+      </v-alert>
+
+      <v-row dense>
+        <v-col cols="7">
+          <v-combobox
+            v-model="material"
+            :items="materials"
+            label="Material"
+            dense
+            outlined
+            hide-details
+            @change="applyMaterialDefault"
+          />
+        </v-col>
+        <v-col cols="5">
+          <v-text-field
+            v-model.number="temp"
+            label="Print temp"
+            suffix="°C"
+            type="number"
+            :min="0"
+            :max="300"
+            dense
+            outlined
+            hide-details
+          />
+        </v-col>
+      </v-row>
+
+      <div class="d-flex align-center mt-3">
+        <span class="text-body-2 mr-2">Color</span>
+        <div
+          class="ace-swatch mr-2"
+          :style="{ backgroundColor: color }"
+        />
+        <code class="text-caption">{{ color }}</code>
+        <v-spacer />
+        <app-btn
+          x-small
+          text
+          @click="showPicker = !showPicker"
+        >
+          {{ showPicker ? 'Hide picker' : 'Pick color' }}
+        </app-btn>
+      </div>
+      <div class="d-flex flex-wrap mt-2">
+        <div
+          v-for="preset in colorPresets"
+          :key="`preset:${preset}`"
+          class="ace-swatch ace-swatch--preset mr-1 mb-1"
+          role="button"
+          :title="preset"
+          :style="{ backgroundColor: preset }"
+          @click="color = preset"
+        />
+      </div>
+      <v-color-picker
+        v-if="showPicker"
+        :value="color"
+        mode="rgba"
+        hide-mode-switch
+        hide-inputs
+        class="mx-auto mt-2"
+        @update:color="setColor"
+      />
+
+      <v-divider class="my-3" />
+
+      <div class="text-subtitle-2 mb-1">
+        Slot actions
+      </div>
+      <div
+        v-if="moveBlockedReason"
+        class="text-caption warning--text mb-2"
+      >
+        {{ moveBlockedReason }}
+      </div>
+
+      <div class="d-flex flex-wrap ace-actions">
+        <app-btn
+          v-if="!isActive"
+          small
+          color="primary"
+          :disabled="!canMove || empty"
+          @click="run(`T${tool}`, true)"
+        >
+          Load T{{ tool }}
+        </app-btn>
+        <app-btn
+          v-else
+          small
+          color="warning"
+          :disabled="!canMove"
+          @click="run('TR', true)"
+        >
+          Unload T{{ tool }}
+        </app-btn>
+        <app-btn
+          small
+          outlined
+          :disabled="!canMove || empty"
+          @click="fullUnload"
+        >
+          Retract to ACE
+        </app-btn>
+        <app-btn
+          small
+          outlined
+          :color="feeding ? 'orange' : undefined"
+          :disabled="!canAssist"
+          @click="run(`ACE_${feeding ? 'DISABLE' : 'ENABLE'}_FEED_ASSIST T=${tool}`)"
+        >
+          {{ feeding ? 'Feed assist off' : 'Feed assist on' }}
+        </app-btn>
+      </div>
+
+      <v-row
+        dense
+        class="mt-2 align-center"
+      >
+        <v-col cols="4">
+          <v-text-field
+            v-model.number="moveLength"
+            label="Length"
+            suffix="mm"
+            type="number"
+            :min="1"
+            dense
+            outlined
+            hide-details
+          />
+        </v-col>
+        <v-col cols="3">
+          <v-text-field
+            v-model.number="moveSpeed"
+            label="Speed"
+            suffix="mm/s"
+            type="number"
+            :min="1"
+            dense
+            outlined
+            hide-details
+          />
+        </v-col>
+        <v-col
+          cols="5"
+          class="d-flex"
+        >
+          <app-btn
+            small
+            outlined
+            color="success"
+            class="mr-1"
+            :disabled="!canMove || !validMove"
+            @click="run(`ACE_FEED T=${tool} LENGTH=${moveLength} SPEED=${moveSpeed}`)"
+          >
+            Feed
+          </app-btn>
+          <app-btn
+            small
+            outlined
+            color="error"
+            :disabled="!canMove || !validMove"
+            @click="run(`ACE_RETRACT T=${tool} LENGTH=${moveLength} SPEED=${moveSpeed}`)"
+          >
+            Retract
+          </app-btn>
+        </v-col>
+      </v-row>
+      <div class="d-flex mt-1 mb-3">
+        <app-btn
+          x-small
+          text
+          :disabled="!klippyReady || !aceEnabled"
+          @click="run(`ACE_STOP_FEED T=${tool}\nACE_STOP_RETRACT T=${tool}`)"
+        >
+          Stop motor
+        </app-btn>
+      </div>
+    </v-card-text>
+
+    <template #actions>
+      <app-btn
+        text
+        color="error"
+        :disabled="!klippyReady || isActive"
