+<template>
+  <v-alert
+    v-if="active"
+    dense
+    text
+    color="primary"
+    class="mb-3 ace-progress"
+  >
+    <div class="d-flex align-center flex-wrap">
+      <v-icon
+        small
+        left
+        color="primary"
+      >
+        {{ icons.swap }}
+      </v-icon>
+      <span class="font-weight-bold mr-2">Tool change</span>
+      <v-chip
+        small
+        label
+        class="mr-2"
+      >
+        {{ fromLabel }}
+      </v-chip>
+      <v-icon small>
+        $chevronRight
+      </v-icon>
+      <v-chip
+        small
+        label
+        color="primary"
+        class="ml-2"
+      >
+        {{ toLabel }}
+      </v-chip>
+      <v-spacer />
+      <span class="text-body-2">{{ stageLabel }}</span>
+    </div>
+
+    <div class="d-flex mt-2 ace-steps">
+      <div
+        v-for="(step, index) in steps"
+        :key="`ace-step:${step.id}`"
+        class="ace-step flex-grow-1 text-center"
+        :class="{ 'ace-step--done': index < stageIndex, 'ace-step--now': index === stageIndex }"
+      >
+        <div class="ace-step__bar" />
+        <div class="text-body-2">
+          {{ step.label }}
+        </div>
+      </div>
+    </div>
+    <div class="text-body-2 mt-1">
+      Estimated from the loaded tool and the filament position.
+    </div>
+  </v-alert>
+</template>
+
+<script lang="ts">
+import { Component, Mixins } from 'vue-property-decorator'
+import { mdiSwapHorizontal } from '@mdi/js'
+import AceProMixin from './acepro'
+
+@Component
+export default class AceProProgress extends Mixins(AceProMixin) {
+  readonly icons = { swap: mdiSwapHorizontal }
+
+  readonly steps = [
+    { id: 'retract', label: 'Retract & cut' },
+    { id: 'unload', label: 'Unload' },
+    { id: 'load', label: 'Load' },
+    { id: 'purge', label: 'Purge & wipe' }
+  ]
+
+  get active (): boolean {
+    return this.aceToolchangeActive
+  }
+
+  get target (): number {
+    const value = this.aceManager?.target_index
+
+    return typeof value === 'number' ? value : -1
+  }
+
+  get fromLabel (): string {
+    return this.aceCurrentTool >= 0 ? `T${this.aceCurrentTool}` : 'empty'
+  }
+
+  get toLabel (): string {
+    return this.target >= 0 ? `T${this.target}` : 'unload'
+  }
+
+  get stageIndex (): number {
+    const position = this.aceFilamentPosition
+
+    if (this.aceCurrentTool >= 0 && this.aceCurrentTool === this.target) return 3
+    if (this.aceCurrentTool >= 0) return position === 'nozzle' ? 0 : 1
+    return position === 'nozzle' ? 3 : 2
+  }
+
+  get stageLabel (): string {
+    return this.steps[this.stageIndex].label + '…'
+  }
+}
+</script>
+
+<style lang="scss" scoped>
+.ace-step {
+  padding: 0 2px;
+  opacity: 0.9;
+}
+
+.ace-step__bar {
+  height: 4px;
+  border-radius: 2px;
+  background: rgba(128, 128, 128, 0.4);
+  margin-bottom: 2px;
+}
+
+.ace-step--done {
+  opacity: 0.9;
+}
+
+.ace-step--done .ace-step__bar {
+  background: var(--v-primary-base);
+}
+
+.ace-step--now {
+  opacity: 1;
+  font-weight: bold;
+}
+
+.ace-step--now .ace-step__bar {
+  background: var(--v-primary-base);
+  animation: ace-step-pulse 1.2s infinite ease-in-out;
+}
+
+@keyframes ace-step-pulse {
+  0%, 100% { opacity: 1; }
+  50% { opacity: 0.35; }
+}
+</style>
diff --git a/src/components/widgets/acepro/AceProRack.vue b/src/components/widgets/acepro/AceProRack.vue
