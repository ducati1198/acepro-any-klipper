+}
+
+.ace-table__dot {
+  width: 18px;
+  height: 18px;
+  border-radius: 50%;
+  border: 1px solid rgba(128, 128, 128, 0.7);
+}
+
+.ace-table__dot--empty {
+  border-style: dashed;
+}
+
+.ace-table__dryer {
