diff --git a/src/components/widgets/acepro/AceCutterWizard.vue b/src/components/widgets/acepro/AceCutterWizard.vue
new file mode 100644
index 0000000..5945ca9
--- /dev/null
+++ b/src/components/widgets/acepro/AceCutterWizard.vue
@@ -0,0 +1,218 @@
+<template>
+  <app-dialog
+    v-model="open"
+    title="Cutter calibration"
+    width="520"
+    no-actions
+  >
+    <v-card-text>
+      <v-alert
+        v-if="!macrosReady"
+        dense
+        text
+        type="warning"
+        class="text-body-2"
+      >
+        The calibration macros are not loaded. Add <code>[include cut_calibrate.cfg]</code> to
+        <code>printer.cfg</code> and restart Klipper.
+      </v-alert>
+      <v-alert
+        v-else-if="aceIsPrinting"
+        dense
+        text
+        type="info"
+        class="text-body-2"
+      >
+        Calibration is locked while a print is running.
+      </v-alert>
+
+      <div class="text-body-2 mb-2">
+        Push the cutter lever a little at a time and watch it. Stop when the blade is fully closed.
+        Going past that point makes the X belt skip teeth.
+      </div>
+
+      <div class="ace-cutter rounded pa-3 mb-3">
+        <div class="d-flex align-center">
+          <div>
+            <div class="text-body-2">
+              Toolhead X
+            </div>
+            <div class="text-h5">
+              {{ currentX == null ? '--' : currentX.toFixed(2) }}
+            </div>
+          </div>
+          <v-spacer />
+          <div class="text-right text-body-2">
+            <div>engage <b>{{ engageX == null ? '--' : engageX }}</b></div>
+            <div>limit <b>{{ fullX == null ? '--' : fullX }}</b></div>
+          </div>
+        </div>
+        <v-progress-linear
+          :value="progress"
+          height="8"
+          rounded
+          class="mt-2"
+          :color="progress > 90 ? 'error' : 'primary'"
+        />
+        <div class="d-flex text-body-2 mt-1">
+          <span>lever untouched</span>
+          <v-spacer />
+          <span>cut_full_x</span>
+        </div>
+      </div>
+
+      <div class="d-flex flex-wrap ace-cutter-actions">
+        <app-btn
+          small
+          color="primary"
+          :disabled="!canRun"
+          @click="run('CUT_CAL_START')"
+        >
+          1. Start
+        </app-btn>
+        <app-btn
+          small
+          outlined
+          :disabled="!canRun"
+          @click="run('CUT_CAL_STEP')"
+        >
+          2. Push 0.5 mm
+        </app-btn>
+        <app-btn
+          small
+          outlined
+          :disabled="!canRun"
+          @click="run('CUT_CAL_STEP STEP=0.2')"
+        >
+          Push 0.2 mm
+        </app-btn>
+        <app-btn
+          small
+          color="warning"
+          :disabled="!canRun"
+          @click="run('CUT_CAL_END')"
+        >
+          3. Back off
+        </app-btn>
+      </div>
+
+      <v-divider class="my-3" />
+
+      <div class="text-subtitle-2 mb-1">
+        Note the positions
+      </div>
+      <div class="d-flex align-center flex-wrap">
+        <app-btn
+          small
+          outlined
+          class="mr-2"
+          :disabled="currentX == null"
+          @click="touchX = currentX"
+        >
+          Lever starts to move
+        </app-btn>
+        <span class="text-body-2 mr-4">{{ touchX == null ? '--' : touchX.toFixed(2) }}</span>
+        <app-btn
+          small
+          outlined
+          class="mr-2"
+          :disabled="currentX == null"
+          @click="bottomX = currentX"
+        >
+          Fully pressed
+        </app-btn>
+        <span class="text-body-2">{{ bottomX == null ? '--' : bottomX.toFixed(2) }}</span>
+      </div>
+
+      <div class="mt-3 d-flex align-center">
+        <app-btn
+          small
+          color="success"
+          :disabled="!canRun || bottomX == null"
+          @click="applyLimit"
+        >
+          Use {{ bottomX == null ? '…' : bottomX.toFixed(2) }} as cut_full_x
+        </app-btn>
+      </div>
+      <div class="text-body-2 mt-1">
+        This applies until Klipper restarts. To keep it, set <code>variable_cut_full_x</code> in
+        <code>acepro_macros.cfg</code> to the same value.
+      </div>
+    </v-card-text>
+  </app-dialog>
+</template>
+
+<script lang="ts">
+import { Component, Mixins, VModel } from 'vue-property-decorator'
+import AceProMixin from './acepro'
+
+@Component
+export default class AceCutterWizard extends Mixins(AceProMixin) {
+  @VModel({ type: Boolean })
+  open!: boolean
+
+  touchX: number | null = null
+  bottomX: number | null = null
+
+  get vars (): Record<string, unknown> {
+    const macro = this.$typedState.printer.printer['gcode_macro _ACE_VARS']
+
+    return macro != null && typeof macro === 'object' ? macro as Record<string, unknown> : {}
+  }
+
+  get macrosReady (): boolean {
+    return 'gcode_macro CUT_CAL_START' in this.$typedState.printer.printer
+  }
+
+  num (value: unknown): number | null {
+    const parsed = Number(value)
+
+    return value == null || !Number.isFinite(parsed) ? null : parsed
+  }
+
+  get engageX (): number | null {
+    return this.num(this.vars.cut_engage_x)
+  }
+
+  get fullX (): number | null {
+    return this.num(this.vars.cut_full_x)
+  }
+
+  get currentX (): number | null {
+    return this.num(this.$typedState.printer.printer.toolhead?.position?.[0])
+  }
+
+  /** 0 at cut_engage_x, 100 at cut_full_x (X decreases while the lever is pushed). */
+  get progress (): number {
+    if (this.engageX == null || this.fullX == null || this.currentX == null) return 0
+
+    const span = this.engageX - this.fullX
+
+    return span <= 0 ? 0 : Math.max(0, Math.min(100, (this.engageX - this.currentX) / span * 100))
+  }
+
+  get canRun (): boolean {
+    return this.klippyReady && this.macrosReady && !this.aceIsPrinting
+  }
+
+  run (gcode: string) {
+    this.aceSendGcode(gcode)
+  }
+
+  applyLimit () {
+    if (this.bottomX == null) return
+
+    this.aceSendGcode(`SET_GCODE_VARIABLE MACRO=_ACE_VARS VARIABLE=cut_full_x VALUE=${this.bottomX.toFixed(2)}`)
+  }
+}
+</script>
+
+<style lang="scss" scoped>
+.ace-cutter {
+  background-color: rgba(128, 128, 128, 0.12);
+}
+
+.ace-cutter-actions > * {
+  margin: 0 6px 6px 0;
+}
+</style>
diff --git a/src/components/widgets/acepro/AceMappingView.vue b/src/components/widgets/acepro/AceMappingView.vue
new file mode 100644
index 0000000..2e2da7d
--- /dev/null
+++ b/src/components/widgets/acepro/AceMappingView.vue
@@ -0,0 +1,237 @@
+<template>
+  <div class="ace-map">
+    <svg
+      :viewBox="`0 0 560 ${height}`"
+      class="ace-map__svg"
+    >
+      <text
+        x="20"
+        y="16"
+        class="ace-map__head"
+      >
+        In the file
+      </text>
+      <text
+        x="540"
+        y="16"
+        text-anchor="end"
+        class="ace-map__head"
+      >
+        On the ACE
+      </text>
+
+      <!-- links first so the nodes sit on top -->
+      <path
+        v-for="row in rows"
+        :key="`map-link:${row.tool}`"
+        :d="curve(row)"
+        fill="none"
+        :stroke="row.color || '#888'"
+        stroke-width="4"
+        stroke-linecap="round"
+        :stroke-dasharray="warned[row.tool] ? '2 7' : undefined"
+        :opacity="selected === row.tool ? 1 : 0.85"
+      />
+
+      <g
+        v-for="(row, index) in rows"
+        :key="`map-src:${row.tool}`"
+        class="ace-map__node"
+        :class="{ 'ace-map__node--selected': selected === row.tool }"
+        role="button"
+        tabindex="0"
+        @click="selected = selected === row.tool ? null : row.tool"
+        @keydown.enter="selected = selected === row.tool ? null : row.tool"
+      >
+        <rect
+          x="8"
+          :y="rowY(index) - 18"
+          width="212"
+          height="36"
+          rx="8"
+          class="ace-map__box"
+        />
+        <circle
+          cx="30"
+          :cy="rowY(index)"
+          r="10"
+          :fill="row.color || '#888'"
+          stroke="rgba(128,128,128,0.8)"
+        />
+        <text
+          x="48"
+          :y="rowY(index) - 2"
+          class="ace-map__label"
+        >
+          T{{ row.tool }} · {{ row.type || 'Filament' }}
+        </text>
+        <text
+          x="48"
+          :y="rowY(index) + 12"
+          class="ace-map__small"
+        >
+          {{ row.name || row.color }}
+        </text>
+      </g>
+
+      <g
+        v-for="(slot, index) in slots"
+        :key="`map-dst:${slot.tool}`"
+        class="ace-map__node"
+        :class="{ 'ace-map__node--disabled': slot.disabled, 'ace-map__node--pickable': selected != null && !slot.disabled }"
+        role="button"
+        tabindex="0"
+        @click="pick(slot)"
+        @keydown.enter="pick(slot)"
+      >
+        <rect
+          x="300"
+          :y="slotY(index) - 14"
+          width="252"
+          height="28"
+          rx="7"
+          class="ace-map__box"
+        />
+        <circle
+          cx="540"
+          :cy="slotY(index)"
+          r="8"
+          :fill="slot.disabled ? 'transparent' : slot.color"
+          :stroke="slot.disabled ? '#888' : 'rgba(128,128,128,0.8)'"
+          :stroke-dasharray="slot.disabled ? '3 2' : undefined"
+        />
+        <text
+          x="310"
+          :y="slotY(index) + 4"
+          class="ace-map__label"
+        >
+          {{ slot.text }}
+        </text>
+      </g>
+    </svg>
+    <div class="text-body-2">
+      Click a filament, then click the spool that should print it. Dotted lines need your attention.
+    </div>
+  </div>
+</template>
+
+<script lang="ts">
+import { Component, Prop, Vue } from 'vue-property-decorator'
+
+interface MapRow {
+  tool: number;
+  color: string;
+  type: string;
+  name: string;
+}
+
+interface MapSlot {
+  tool: number;
+  text: string;
+  color: string;
+  disabled: boolean;
+}
+
+@Component
+export default class AceMappingView extends Vue {
+  @Prop({ type: Array, required: true })
+  readonly rows!: MapRow[]
+
+  @Prop({ type: Array, required: true })
+  readonly slots!: MapSlot[]
+
+  @Prop({ type: Object, required: true })
+  readonly mapping!: Record<number, number>
+
+  @Prop({ type: Object, default: () => ({}) })
+  readonly warned!: Record<number, boolean>
+
+  selected: number | null = null
+
+  get height (): number {
+    return Math.max(this.rows.length * 46, this.slots.length * 34) + 36
+  }
+
+  rowY (index: number): number {
+    const span = Math.max(this.rows.length * 46, 1)
+    const offset = (this.height - 36 - span) / 2
+
+    return 40 + offset + index * 46
+  }
+
+  slotY (index: number): number {
+    return 40 + index * 34
+  }
+
+  curve (row: MapRow): string {
+    const from = this.rows.findIndex(item => item.tool === row.tool)
+    const to = this.slots.findIndex(item => item.tool === this.mapping[row.tool])
+
+    if (from < 0 || to < 0) return ''
+
+    const y1 = this.rowY(from)
+    const y2 = this.slotY(to)
+
+    return `M220 ${y1} C 260 ${y1}, 260 ${y2}, 300 ${y2}`
+  }
+
+  pick (slot: MapSlot) {
+    if (this.selected == null || slot.disabled) return
+
+    this.$emit('change', this.selected, slot.tool)
+    this.selected = null
+  }
+}
+</script>
+
+<style lang="scss" scoped>
+.ace-map__svg {
+  width: 100%;
+  display: block;
+}
+
+.ace-map__head {
+  font-size: 12px;
+  fill: currentColor;
+  text-transform: uppercase;
+}
+
+.ace-map__box {
+  fill: rgba(128, 128, 128, 0.12);
+  stroke: rgba(128, 128, 128, 0.35);
+}
+
+.ace-map__node {
+  cursor: pointer;
+  outline: none;
+}
+
+.ace-map__node:hover .ace-map__box {
+  fill: rgba(128, 128, 128, 0.22);
+}
+
+.ace-map__node--selected .ace-map__box {
+  stroke: var(--v-primary-base);
+  stroke-width: 2.5;
+}
+
+.ace-map__node--pickable .ace-map__box {
+  stroke: var(--v-primary-base);
+  stroke-dasharray: 4 3;
+}
+
+.ace-map__node--disabled {
+  cursor: default;
+}
+
+.ace-map__label {
+  font-size: 12px;
+  font-weight: bold;
+  fill: currentColor;
+}
+
+.ace-map__small {
+  font-size: 11px;
+  fill: currentColor;
+}
+</style>
