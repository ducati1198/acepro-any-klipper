+<template>
+  <div
+    class="ace-unit rounded pa-2"
+    :class="$vuetify.theme.dark ? 'grey darken-4' : 'grey lighten-4'"
+  >
+    <div class="d-flex align-center flex-wrap mb-2">
+      <span
+        v-if="showTitle"
+        class="font-weight-bold mr-2"
+      >
+        ACE {{ unit.index + 1 }}
+      </span>
+      <v-chip
+        x-small
+        label
+        :color="connectionColor"
+        class="mr-2"
+      >
+        {{ connectionLabel }}
+      </v-chip>
+      <span class="text-caption secondary--text text-truncate">
+        {{ deviceLabel }}
+      </span>
+      <v-spacer />
+      <span
+        class="text-caption"
+        title="ACE chamber"
+      >
+        <v-icon x-small>$thermometer</v-icon>
+        {{ temperatureLabel }}
+        <template v-if="unit.state.humidity">
+          · {{ unit.state.humidity }}% RH
+        </template>
+      </span>
+    </div>
+
+    <v-row
+      dense
+      no-gutters
+    >
+      <v-col
+        v-for="slot in slots"
+        :key="`ace-slot:${unit.index}:${slot.index}`"
+        cols="3"
+        class="px-1"
+      >
+        <ace-pro-slot
+          :slot-state="slot"
+          :active="slot.tool === aceCurrentTool"
+          :feeding="unit.state.feed_assist_slot === slot.index"
+          @click="$emit('slot-click', slot.index)"
+        />
+      </v-col>
+    </v-row>
+
+    <v-divider class="my-2" />
+
+    <div class="d-flex align-center flex-wrap">
+      <v-icon
+        small
+        class="mr-1"
+        :color="drying ? 'orange' : undefined"
+      >
+        $fan
+      </v-icon>
+      <span class="text-body-2 mr-2">Dryer</span>
+      <v-chip
+        x-small
+        label
+        :color="drying ? 'orange' : undefined"
+        :class="{ 'ace-pulse': drying }"
+        class="mr-2"
+      >
+        {{ drying ? `${dryer.target_temp || '?'}°C · ${remainingLabel} left` : 'Idle' }}
+      </v-chip>
+      <v-spacer />
+      <template v-if="!drying">
+        <v-select
+          v-model="dryTemp"
+          :items="tempOptions"
+          suffix="°C"
+          dense
+          outlined
+          hide-details
+          class="ace-compact-select mr-1"
+        />
+        <v-select
+          v-model="dryDuration"
+          :items="durationOptions"
+          dense
+          outlined
+          hide-details
+          class="ace-compact-select mr-1"
+        />
+      </template>
+      <app-btn
+        x-small
+        :color="drying ? 'error' : 'primary'"
+        :disabled="!klippyReady || !aceUnitConnected(unit)"
+        @click="toggleDryer"
+      >
+        {{ drying ? 'Stop' : 'Dry' }}
+      </app-btn>
+    </div>
+  </div>
+</template>
+
+<script lang="ts">
+import { Component, Mixins, Prop } from 'vue-property-decorator'
+import AceProMixin from './acepro'
+import AceProSlot from './AceProSlot.vue'
+import type { AceDryerState, AceSlotState, AceUnit } from './types'
+
+@Component({
+  components: {
+    AceProSlot
+  }
+})
+export default class AceProUnit extends Mixins(AceProMixin) {
+  @Prop({ type: Object, required: true })
+  readonly unit!: AceUnit
+
+  @Prop({ type: Boolean })
+  readonly showTitle?: boolean
+
+  dryTemp = 50
+  dryDuration = 240
+
+  readonly tempOptions = [35, 40, 45, 50, 55, 60, 65]
+
+  readonly durationOptions = [30, 60, 120, 180, 240, 360, 480, 720]
+    .map(value => ({ value, text: value < 60 ? `${value} min` : `${value / 60} h` }))
+
+  get slots (): AceSlotState[] {
+    return this.aceUnitSlots(this.unit)
+  }
+
+  get dryer (): AceDryerState {
+    return this.aceUnitDryer(this.unit)
+  }
+
+  get drying (): boolean {
+    return this.aceIsDrying(this.dryer)
+  }
+
+  get remainingLabel (): string {
+    const total = this.aceDryerRemainingSeconds(this.dryer)
+    const hours = Math.floor(total / 3600)
+    const minutes = Math.floor((total % 3600) / 60)
+
+    return hours > 0
+      ? `${hours}h ${minutes.toString().padStart(2, '0')}m`
+      : `${minutes}m`
+  }
+
+  get connectionLabel (): string {
+    const state = this.unit.state.connection_state
+
+    if (!state) return 'no data'
+    return state
+  }
+
+  get connectionColor (): string | undefined {
+    switch (this.unit.state.connection_state) {
+      case 'connected': return 'success'
+      case 'connecting':
+      case 'initializing':
+      case 'reconnecting': return 'warning'
+      case 'disabled': return undefined
+      default: return 'error'
+    }
+  }
+
+  get deviceLabel (): string {
+    const parts = [
+      this.unit.state.model,
+      this.unit.state.firmware ? `fw ${this.unit.state.firmware}` : undefined,
+      this.unit.state.usb_port
+    ].filter(Boolean)
+
+    return parts.join(' · ')
+  }
+
+  get temperatureLabel (): string {
+    const temp = this.unit.state.temp
+
+    return typeof temp === 'number' && temp > 0
+      ? `${temp}°C`
+      : '--°C'
+  }
+
+  async toggleDryer () {
+    const instance = this.unit.index
+
+    if (this.drying) {
+      const result = await this.$confirm(
+        'Stop drying? This turns off the ACE heater and fans.',
+        { title: 'Stop dryer', color: 'card-heading', icon: '$error' }
+      )
+
+      if (result) {
+        this.aceSendGcode(`ACE_STOP_DRYING INSTANCE=${instance}`)
+      }
+      return
+    }
+
+    this.aceSendGcode(`ACE_START_DRYING INSTANCE=${instance} TEMP=${this.dryTemp} DURATION=${this.dryDuration}`)
+  }
+}
+</script>
