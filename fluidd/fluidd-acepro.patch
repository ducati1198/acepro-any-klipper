+              </v-icon>
+            </td>
+            <td>{{ aceSlotIsEmpty(slot) || !slot.temp ? '--' : `${slot.temp}°C` }}</td>
+            <td :class="statusClass(slot)">
+              {{ statusLabel(slot, unit.state.feed_assist_slot) }}
+            </td>
+            <td class="text-right text-no-wrap">
+              <app-btn
+                v-if="slot.tool !== aceCurrentTool"
+                x-small
+                color="primary"
+                text
+                :disabled="!aceCanMove || aceSlotIsEmpty(slot)"
+                @click="aceSendGcode(`T${slot.tool}`)"
+              >
+                Load
+              </app-btn>
+              <app-btn
+                v-else
+                x-small
+                color="warning"
+                text
+                :disabled="!aceCanMove"
+                @click="aceSendGcode('TR')"
+              >
+                Unload
+              </app-btn>
+              <app-btn
+                small
+                text
+                @click="$emit('slot-click', { unit: unit.index, slot: slot.index })"
+              >
+                Edit
+              </app-btn>
+            </td>
+          </tr>
+        </template>
+      </tbody>
+    </v-simple-table>
+  </div>
+</template>
+
+<script lang="ts">
+import { Component, Mixins } from 'vue-property-decorator'
+import { mdiNfcVariant } from '@mdi/js'
+import AceProMixin from './acepro'
+import AceProDryer from './AceProDryer.vue'
+import type { AceSlotState } from './types'
+
+@Component({
+  components: { AceProDryer }
+})
+export default class AceProTable extends Mixins(AceProMixin) {
+  readonly icons = { nfc: mdiNfcVariant }
+
+  statusLabel (slot: AceSlotState, feedSlot: number | undefined): string {
+    if (slot.tool === this.aceCurrentTool) return 'loaded'
+    if (feedSlot === slot.index) return 'feeding'
+    return slot.status || 'unknown'
+  }
+
+  statusClass (slot: AceSlotState): string {
+    if (slot.tool === this.aceCurrentTool) return 'primary--text'
+    if (this.aceSlotIsEmpty(slot)) return ''
+    return slot.status === 'ready' ? 'success--text' : 'warning--text'
+  }
+}
+</script>
+
+<style lang="scss" scoped>
+.ace-table__unit {
+  background-color: rgba(128, 128, 128, 0.1);
+}
+
+.ace-table__row--active {
