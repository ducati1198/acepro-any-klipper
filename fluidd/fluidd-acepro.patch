+      <div class="d-flex flex-wrap ace-actions">
+        <app-btn
+          v-if="!isActive"
+          small
+          color="primary"
+          :disabled="!canMove || empty"
+          @click="run(`T${tool}`, true)"
+        >
+          Load T{{ tool }}
+        </app-btn>
+        <app-btn
+          v-else
+          small
+          color="warning"
+          :disabled="!canMove"
+          @click="run('TR', true)"
+        >
+          Unload T{{ tool }}
+        </app-btn>
+        <app-btn
+          small
+          outlined
+          color="primary"
+          :disabled="!canMove || empty"
+          @click="fullUnload"
+        >
+          Retract to ACE
+        </app-btn>
+        <app-btn
+          small
+          outlined
+          :color="feeding ? 'orange' : 'primary'"
+          :disabled="!canAssist"
+          @click="run(`ACE_${feeding ? 'DISABLE' : 'ENABLE'}_FEED_ASSIST T=${tool}`)"
+        >
+          {{ feeding ? 'Feed assist off' : 'Feed assist on' }}
+        </app-btn>
+      </div>
+
+      <v-row
+        dense
+        class="mt-2 align-center"
+      >
+        <v-col cols="4">
