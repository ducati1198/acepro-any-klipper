+<template>
+  <collapsable-card
+    title="ACE Pro"
+    icon="$mmu"
+    draggable
+    layout-path="dashboard.ace-pro-card"
+  >
+    <template #menu>
+      <app-btn
+        icon
+        small
+        :disabled="!klippyReady || !aceEnabled"
+        title="Refresh slots"
+        @click="refresh"
+      >
+        <v-icon dense>
+          $refresh
+        </v-icon>
+      </app-btn>
+      <ace-pro-settings-menu />
+    </template>
+
+    <v-card-text class="pt-1">
+      <v-alert
+        v-if="!aceEnabled"
+        dense
+        text
+        type="info"
+        class="mb-3"
+      >
+        <div class="d-flex align-center flex-wrap">
+          <span class="mr-2">ACE Pro support is turned off. Tool changes and slot moves are ignored.</span>
+          <v-spacer />
+          <app-btn
+            v-if="aceEnablePinName"
+            small
+            color="primary"
+            :disabled="!klippyReady"
+            @click="setEnabled(true)"
+          >
+            Turn on
+          </app-btn>
+        </div>
+      </v-alert>
+
+      <div class="d-flex flex-wrap align-center ace-status-row">
+        <v-chip
+          small
+          label
+          :color="aceCurrentTool >= 0 ? 'primary' : undefined"
+          class="mr-1 mb-1"
+        >
+          <v-icon
+            x-small
+            left
+          >
+            $printer3dNozzle
+          </v-icon>
+          {{ aceCurrentTool >= 0 ? `T${aceCurrentTool} loaded` : 'No tool loaded' }}
+        </v-chip>
+        <v-chip
+          small
+          label
+          outlined
+          class="mr-1 mb-1"
+        >
+          Filament: {{ positionLabel }}
+        </v-chip>
+        <v-chip
+          v-for="sensor in sensors"
+          :key="`sensor:${sensor.name}`"
+          small
+          label
+          outlined
+          :color="sensor.color"
+          class="mr-1 mb-1"
+        >
+          {{ sensor.name }}: {{ sensor.label }}
+        </v-chip>
+        <v-chip
+          v-if="aceManager && aceManager.endless_spool_enabled"
+          small
+          label
+          outlined
+          color="success"
+          class="mr-1 mb-1"
+        >
+          Endless spool: {{ aceManager.endless_spool_match_mode || 'exact' }}
+        </v-chip>
+        <v-chip
+          v-if="toolMapText"
+          small
+          label
+          outlined
+          :color="aceManager && aceManager.tool_map_active ? 'primary' : undefined"
+          :close="!aceIsPrinting"
+          class="mr-1 mb-1"
+          :title="aceManager && aceManager.tool_map_file ? `For ${aceManager.tool_map_file}` : undefined"
+          @click:close="aceSendGcode('ACE_CLEAR_TOOL_MAP')"
+        >
+          Spools: {{ toolMapText }}
+        </v-chip>
+        <v-spacer />
+        <app-btn
+          v-if="aceCurrentTool >= 0"
+          x-small
+          outlined
+          color="warning"
+          class="mb-1"
+          :disabled="!canMove"
+          @click="unloadCurrent"
+        >
+          Unload T{{ aceCurrentTool }}
+        </app-btn>
+      </div>
+
+      <ace-pro-unit
+        v-for="unit in aceUnits"
+        :key="`ace-unit:${unit.index}`"
+        :unit="unit"
+        :show-title="aceUnits.length > 1"
+        class="mt-3"
+        @slot-click="openSlot(unit.index, $event)"
+      />
+    </v-card-text>
+
+    <ace-pro-slot-dialog
+      v-if="dialog.open"
+      v-model="dialog.open"
+      :unit-index="dialog.unit"
+      :slot-index="dialog.slot"
+    />
+  </collapsable-card>
+</template>
+
+<script lang="ts">
+import { Component, Mixins } from 'vue-property-decorator'
+import AceProMixin from './acepro'
+import AceProUnit from './AceProUnit.vue'
+import AceProSlotDialog from './AceProSlotDialog.vue'
+import AceProSettingsMenu from './AceProSettingsMenu.vue'
+
+const POSITION_LABELS: Record<string, string> = {
+  bowden: 'in bowden (unloaded)',
+  splitter: 'at splitter',
+  toolhead: 'at toolhead',
+  nozzle: 'in nozzle'
+}
+
+@Component({
+  components: {
+    AceProUnit,
+    AceProSlotDialog,
+    AceProSettingsMenu
+  }
+})
+export default class AceProCard extends Mixins(AceProMixin) {
+  dialog = {
+    open: false,
+    unit: 0,
+    slot: 0
+  }
+
+  get positionLabel (): string {
+    return POSITION_LABELS[this.aceFilamentPosition] ?? this.aceFilamentPosition
+  }
+
+  get sensors () {
+    const describe = (name: string, value: boolean | null | undefined) => ({
+      name,
+      label: value == null ? 'n/a' : value ? 'filament' : 'empty',
+      color: value == null ? undefined : value ? 'success' : 'grey'
+    })
+
+    return [
+      describe('Toolhead', this.aceManager?.toolhead_sensor),
+      describe('Splitter', this.aceManager?.rdm_sensor)
+    ].filter(sensor => sensor.label !== 'n/a')
+  }
+
+  get toolMapText (): string {
+    const map = this.aceManager?.tool_map ?? {}
+
+    return Object.entries(map)
+      .map(([from, to]) => `T${from}→T${to}`)
+      .join(', ')
+  }
+
+  get canMove (): boolean {
+    return this.klippyReady && this.aceEnabled && !this.aceIsPrinting
+  }
+
+  openSlot (unit: number, slot: number) {
+    this.dialog = { open: true, unit, slot }
+  }
+
+  refresh () {
+    this.aceSendGcode('ACE_QUERY_SLOTS')
+  }
+
+  setEnabled (enabled: boolean) {
+    if (this.aceEnablePinName) {
+      this.aceSendGcode(`SET_PIN PIN=${this.aceEnablePinName} VALUE=${enabled ? 1 : 0}`)
+    }
+  }
+
+  async unloadCurrent () {
+    const result = await this.$confirm(
+      `Unload T${this.aceCurrentTool} back to the ACE?`,
+      { title: 'Unload tool', color: 'card-heading', icon: '$error' }
+    )
+
+    if (result) {
+      this.aceSendGcode('TR')
+    }
+  }
+}
+</script>
+
+<style lang="scss" scoped>
+.ace-status-row :deep(.v-chip) {
+  text-transform: none;
+}
+</style>
