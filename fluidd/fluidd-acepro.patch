@@ -0,0 +1,111 @@
+import Vue from 'vue'
+
+export type AceLayout = 'grid' | 'strip' | 'rack' | 'table'
+
+export const ACE_LAYOUTS: AceLayout[] = ['grid', 'strip', 'rack', 'table']
+
+const LAYOUT_KEY = 'fluidd-ace-layout'
+const MAP_PRESETS_KEY = 'fluidd-ace-map-presets'
+const MAP_FILE_PREFIX = 'fluidd-ace-map-file:'
+
+const readStorage = (key: string): string | null => {
+  try {
+    return window.localStorage.getItem(key)
+  } catch {
+    return null
+  }
+}
+
+const writeStorage = (key: string, value: string) => {
+  try {
+    window.localStorage.setItem(key, value)
+  } catch {
+    // storage can be blocked; the UI just forgets the choice
+  }
+}
+
+const readLayout = (): AceLayout => {
+  const value = readStorage(LAYOUT_KEY)
+
+  return ACE_LAYOUTS.includes(value as AceLayout) ? value as AceLayout : 'grid'
+}
+
+// Shared UI state for the ACE Pro card, its dialogs and the full page.
+export const aceUi = Vue.observable({
+  layout: readLayout(),
+  cutterWizard: false,
+  health: false
+})
+
+export const setAceLayout = (layout: AceLayout) => {
+  aceUi.layout = layout
+  writeStorage(LAYOUT_KEY, layout)
+}
+
+export interface AceDryPreset {
+  id: string;
+  label: string;
+  temp: number;
+  minutes: number;
+  materials: string[];
+}
+
+// Drying presets. The ACE heater tops out at 65 °C, so nothing here goes above it.
+export const ACE_DRY_PRESETS: AceDryPreset[] = [
+  { id: 'pla', label: 'PLA', temp: 45, minutes: 240, materials: ['PLA', 'PLA+', 'PLA-CF', 'PVA'] },
+  { id: 'petg', label: 'PETG', temp: 55, minutes: 360, materials: ['PETG', 'PETG-CF'] },
+  { id: 'abs', label: 'ABS / ASA', temp: 65, minutes: 360, materials: ['ABS', 'ASA', 'HIPS', 'PC'] },
+  { id: 'tpu', label: 'TPU', temp: 50, minutes: 360, materials: ['TPU'] },
+  { id: 'pa', label: 'Nylon (PA)', temp: 65, minutes: 480, materials: ['PA', 'PA-CF', 'NYLON'] }
+]
+
+export const dryPresetFor = (material: string | undefined): AceDryPreset | undefined => {
+  const key = (material ?? '').toUpperCase().replace(/[\s_]+/g, '')
+
+  return ACE_DRY_PRESETS.find(preset => preset.materials.includes(key))
+}
+
+export const formatMinutes = (minutes: number): string => {
+  if (minutes < 60) return `${minutes} min`
+
+  const hours = Math.floor(minutes / 60)
+  const rest = minutes % 60
+
+  return rest === 0 ? `${hours} h` : `${hours} h ${rest} min`
+}
+
+export interface AceSavedMapping {
+  name: string;
+  map: Record<number, number>;
+}
+
+export const loadMapPresets = (): AceSavedMapping[] => {
+  try {
+    const parsed: unknown = JSON.parse(readStorage(MAP_PRESETS_KEY) ?? '[]')
+
+    return Array.isArray(parsed)
+      ? parsed.filter((item): item is AceSavedMapping =>
+        item != null && typeof item.name === 'string' && typeof item.map === 'object')
+      : []
+  } catch {
+    return []
+  }
+}
+
+export const saveMapPresets = (presets: AceSavedMapping[]) => {
+  writeStorage(MAP_PRESETS_KEY, JSON.stringify(presets))
+}
+
+export const loadFileMapping = (filename: string): Record<number, number> | undefined => {
+  try {
+    const parsed: unknown = JSON.parse(readStorage(MAP_FILE_PREFIX + filename) ?? 'null')
+
+    return parsed != null && typeof parsed === 'object' ? parsed as Record<number, number> : undefined
+  } catch {
+    return undefined
+  }
+}
+
+export const saveFileMapping = (filename: string, map: Record<number, number>) => {
+  writeStorage(MAP_FILE_PREFIX + filename, JSON.stringify(map))
+}
