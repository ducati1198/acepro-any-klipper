+        >
+          $chevronRight
+        </v-icon>
+
+        <div class="flex-grow-1">
+          <v-select
+            :value="mapping[row.tool]"
+            :items="slotItems"
+            item-value="tool"
+            item-disabled="disabled"
+            dense
+            outlined
+            hide-details
+            @change="setMapping(row.tool, $event)"
+          >
+            <template #selection="{ item }">
+              <div class="d-flex align-center text-truncate">
+                <div
+                  class="ace-dot ace-dot--small mr-2"
+                  :style="{ backgroundColor: item.color }"
+                />
+                <span class="text-truncate">{{ item.text }}</span>
+              </div>
+            </template>
+            <template #item="{ item }">
+              <div class="d-flex align-center">
+                <div
+                  class="ace-dot ace-dot--small mr-2"
+                  :style="{ backgroundColor: item.color }"
+                />
+                <span>{{ item.text }}</span>
