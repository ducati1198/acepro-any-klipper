+<template>
+  <div
+    class="ace-unit rounded pa-3"
+    :class="$vuetify.theme.dark ? 'grey darken-4' : 'grey lighten-4'"
+  >
+    <div class="d-flex align-center flex-wrap mb-2">
+      <span
+        v-if="showTitle"
+        class="text-h6 mr-2"
+      >
+        ACE {{ unit.index + 1 }}
+      </span>
+      <v-chip
+        small
+        label
+        :color="connectionColor"
+        class="mr-2"
+      >
+        {{ connectionLabel }}
+      </v-chip>
+      <span class="text-body-2 text-truncate">
+        {{ deviceLabel }}
+      </span>
+      <v-spacer />
+      <span
+        class="text-body-1"
+        title="ACE chamber"
+      >
+        <v-icon small>$thermometer</v-icon>
+        {{ temperatureLabel }}
+        <template v-if="unit.state.humidity">
+          · {{ unit.state.humidity }}% RH
+        </template>
+      </span>
+    </div>
+
+    <v-row
+      dense
+      no-gutters
+    >
+      <v-col
+        v-for="slot in slots"
+        :key="`ace-slot:${unit.index}:${slot.index}`"
+        cols="3"
+        class="px-1"
+      >
+        <ace-pro-slot
+          :slot-state="slot"
+          :active="slot.tool === aceCurrentTool"
+          :feeding="unit.state.feed_assist_slot === slot.index"
+          @click="$emit('slot-click', slot.index)"
+        />
+      </v-col>
+    </v-row>
+
+    <v-divider class="my-2" />
+
+    <ace-pro-dryer :unit="unit" />
+  </div>
+</template>
+
+<script lang="ts">
+import { Component, Mixins, Prop } from 'vue-property-decorator'
+import AceProMixin from './acepro'
+import AceProSlot from './AceProSlot.vue'
+import AceProDryer from './AceProDryer.vue'
+import type { AceSlotState, AceUnit } from './types'
+
+@Component({
+  components: {
+    AceProSlot,
+    AceProDryer
+  }
+})
+export default class AceProUnit extends Mixins(AceProMixin) {
+  @Prop({ type: Object, required: true })
+  readonly unit!: AceUnit
+
+  @Prop({ type: Boolean })
+  readonly showTitle?: boolean
+
+  get slots (): AceSlotState[] {
+    return this.aceUnitSlots(this.unit)
+  }
+
+  get connectionLabel (): string {
+    const state = this.unit.state.connection_state
+
+    if (!state) return 'no data'
+    return state
+  }
+
+  get connectionColor (): string | undefined {
+    switch (this.unit.state.connection_state) {
+      case 'connected': return 'success'
+      case 'connecting':
+      case 'initializing':
+      case 'reconnecting': return 'warning'
+      case 'disabled': return undefined
+      default: return 'error'
+    }
+  }
+
+  get deviceLabel (): string {
+    const parts = [
+      this.unit.state.model,
+      this.unit.state.firmware ? `fw ${this.unit.state.firmware}` : undefined,
+      this.unit.state.usb_port
+    ].filter(Boolean)
+
+    return parts.join(' · ')
+  }
+
+  get temperatureLabel (): string {
+    const temp = this.unit.state.temp
+
+    return typeof temp === 'number' && temp > 0
+      ? `${temp}°C`
+      : '--°C'
+  }
+}
+</script>
diff --git a/src/components/widgets/acepro/aceUi.ts b/src/components/widgets/acepro/aceUi.ts
