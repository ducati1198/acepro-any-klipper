@@ -0,0 +1,185 @@
+<template>
+  <div class="ace-health">
+    <div class="text-subtitle-2 mb-1">
+      Units
+    </div>
+    <v-simple-table dense>
+      <thead>
+        <tr>
+          <th>Unit</th>
+          <th>Connection</th>
+          <th>Firmware</th>
+          <th>Port</th>
+          <th>Protocol</th>
+          <th>RFID sync</th>
+          <th>Chamber</th>
+          <th />
+        </tr>
+      </thead>
+      <tbody>
+        <tr
+          v-for="unit in aceUnits"
+          :key="`health:${unit.index}`"
+        >
+          <td class="font-weight-bold text-no-wrap">
+            ACE {{ unit.index + 1 }}
+          </td>
+          <td>
+            <v-chip
+              x-small
+              label
+              :color="connectionColor(unit)"
+            >
+              {{ unit.state.connection_state || 'no data' }}
+            </v-chip>
+          </td>
+          <td>{{ unit.state.firmware || '–' }}</td>
+          <td class="text-body-2">
+            {{ unit.state.usb_port || '–' }}
+          </td>
+          <td class="text-body-2">
+            {{ unit.state.protocol || '–' }}
+          </td>
+          <td>{{ unit.state.rfid_sync_enabled ? 'on' : 'off' }}</td>
+          <td>
+            {{ chamber(unit) }}
+          </td>
+          <td class="text-right text-no-wrap">
+            <app-btn
+              small
+              text
+              :disabled="!klippyReady || !aceEnabled"
+              @click="aceSendGcode(`ACE_RECONNECT INSTANCE=${unit.index}`)"
+            >
+              Reconnect
+            </app-btn>
+          </td>
+        </tr>
+      </tbody>
+    </v-simple-table>
+    <div class="mt-2">
+      <app-btn
+        small
+        outlined
+        :disabled="!klippyReady"
+        @click="aceSendGcode('ACE_GET_CONNECTION_STATUS')"
+      >
+        Connection report in console
+      </app-btn>
+    </div>
+
+    <div class="text-subtitle-2 mt-4 mb-1">
+      Counters
+    </div>
+    <v-row dense>
+      <v-col
+        cols="4"
+        class="text-center"
+      >
+        <div class="text-h5">
+          {{ stats.tool_changes || 0 }}
+        </div>
+        <div class="text-body-2">
+          Tool changes
+        </div>
+      </v-col>
+      <v-col
+        cols="4"
+        class="text-center"
+      >
+        <div class="text-h5">
+          {{ stats.cuts || 0 }}
+        </div>
+        <div class="text-body-2">
+          Filament cuts
+        </div>
+      </v-col>
+      <v-col
+        cols="4"
+        class="text-center"
+      >
+        <div class="text-h5">
+          {{ purgeGrams }} g
+        </div>
+        <div class="text-body-2">
+          Purged ({{ Math.round((stats.purge_mm || 0) / 10) / 100 }} m)
+        </div>
+      </v-col>
+    </v-row>
+    <div class="text-body-2 mt-1">
+      Purge weight assumes 1.75 mm PLA. Counting started when the driver was updated.
+    </div>
+    <div
+      v-if="cutWarning"
+      class="text-body-2 warning--text mt-2"
+    >
+      {{ cutWarning }}
+    </div>
+    <div class="mt-2">
+      <app-btn
+        small
+        text
+        color="error"
+        :disabled="!klippyReady"
+        @click="resetStats"
+      >
+        Reset counters…
+      </app-btn>
+    </div>
+  </div>
+</template>
+
+<script lang="ts">
+import { Component, Mixins } from 'vue-property-decorator'
+import AceProMixin from './acepro'
+import type { AceStats, AceUnit } from './types'
+
+// Filament in 1.75 mm PLA weighs about 3 g per metre
+const GRAMS_PER_MM = 0.003
+
+@Component
+export default class AceProHealth extends Mixins(AceProMixin) {
+  get stats (): AceStats {
+    return this.aceManager?.stats ?? {}
+  }
+
+  get purgeGrams (): number {
+    return Math.round((this.stats.purge_mm ?? 0) * GRAMS_PER_MM)
+  }
+
+  get cutWarning (): string {
+    return (this.stats.cuts ?? 0) >= 2000
+      ? 'The cutter has made 2000 cuts or more. Check the blade and the lever.'
+      : ''
+  }
+
+  connectionColor (unit: AceUnit): string | undefined {
+    switch (unit.state.connection_state) {
+      case 'connected': return 'success'
+      case 'connecting':
+      case 'initializing':
+      case 'reconnecting': return 'warning'
+      case 'disabled': return undefined
+      default: return 'error'
+    }
+  }
+
+  chamber (unit: AceUnit): string {
+    const temp = unit.state.temp
+    const parts = [typeof temp === 'number' && temp > 0 ? `${temp}°C` : '--']
+
+    if (unit.state.humidity) parts.push(`${unit.state.humidity}% RH`)
+    return parts.join(' · ')
+  }
+
+  async resetStats () {
+    const result = await this.$confirm('Reset the tool change, cut and purge counters to zero?', {
+      title: 'Reset counters',
+      color: 'card-heading',
+      icon: '$error'
+    })
+
+    if (result) this.aceSendGcode('ACE_RESET_STATS')
+  }
+}
+</script>
